@using MeetingRecord.Web.Client.Uploads
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager
@inject MeetingUploadManager UploadManager
@inject ModalService ModalService

@* WASM 端的路由（1.1.1）。1.1.45 起應用程式的頁面全部在這裡（含首頁與找不到頁）；只有 ServerPageRoutes 列的
   登入、登出、等待核准與錯誤頁由伺服器靜態算繪，往那裡要整頁載入。 *@
<ConfigProvider>
    <Router AppAssembly="typeof(ClientRoutes).Assembly" NotFoundPage="typeof(Pages.NotFoundPage)" OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(WasmLayout)" />
        </Found>
    </Router>

    <AntContainer />
</ConfigProvider>

@code {
    private IDisposable? locationChangingRegistration;

    protected override void OnInitialized()
    {
        locationChangingRegistration = NavigationManager.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    /// <summary>
    /// 1.1.23：上傳由整個前端共用（<see cref="MeetingUploadManager"/>），頁面之間切換不會中斷；
    /// 要去的是伺服器頁（登入、登出、等待核准、錯誤頁，1.1.45 起見 <see cref="ServerPageRoutes"/>）就是整頁載入，上傳會中斷，先問（1.1.6）。
    /// </summary>
    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (UploadManager.ActiveCount == 0)
        {
            return;
        }

        var path = "/" + NavigationManager.ToBaseRelativePath(context.TargetLocation).Split('?', '#')[0];
        if (!ServerPageRoutes.IsServerPage(path))
        {
            return;
        }

        var leave = await ModalService.ConfirmAsync(new ConfirmOptions
        {
            Title = "上傳還在進行",
            Content = "影音檔或附件還在上傳，離開這頁會中斷上傳。確定要離開嗎？",
            OkText = "離開",
            CancelText = "留下",
        });

        if (!leave)
        {
            context.PreventNavigation();
            return;
        }

        // 已確認要離開：拿掉 beforeunload，免得接著整頁載入時瀏覽器再問一次。
        await UploadManager.ReleaseLeaveGuardAsync();
    }

    private Task OnNavigateAsync(NavigationContext context)
    {
        // context.Path 會帶查詢字串（IsServerPage 會忽略，1.1.39）；整頁載入時用 NavigationManager.Uri（已是目標網址）保留查詢字串。
        if (ServerPageRoutes.IsServerPage("/" + context.Path))
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true, replace: true);
        }

        return Task.CompletedTask;
    }

    public void Dispose() => locationChangingRegistration?.Dispose();
}
