@inherits LayoutComponentBase
@inject SessionService SessionService
@inject AccountApi AccountApi
@inject SystemApi SystemApi
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject MeetingRecord.Web.Client.Services.ClientErrorReporter ClientErrorReporter

@* WASM 端的版面：開頁先問 Session API，依結果導向（登入、登出原因、改密碼），通過才畫外框。
   外框用共用的 AppShell（1.1.5），與 Blazor Server 頁的 MainLayout 同一份外觀；這裡供應 API 來的資料：
   選單與使用者來自 Session、通知鈴的資料來源是 ApiNotificationSource、變更密碼與關於打 API（1.1.6）；
   右下角的背景工作進度面板（1.1.15）資料來源是 ApiJobProgressSource。 *@
@if (session is null)
{
    <div class="wasm-loading">
        @if (errorMessage is null)
        {
            <Spin Tip="載入中…" />
        }
        else
        {
            <div class="app-error-banner" role="alert">@errorMessage</div>
        }
    </div>
}
else
{
    <AppShell MenuItems="menu"
              SystemName="@session.SystemName"
              UserDisplayName="@(string.IsNullOrWhiteSpace(session.Name) ? session.Account : session.Name)"
              IsAdmin="session.IsAdmin"
              IsSupportAccount="session.IsSupportAccount"
              ChangePasswordAsync="ChangePasswordAsync"
              LoadAboutAsync="LoadAboutAsync">
        <NotificationContent>
            <NotificationBell UserId="@session.UserId" />
        </NotificationContent>
        <OverlayContent>
            @* 常駐於所有 WASM 頁：上傳、轉錄與會議紀錄生成的進度（1.1.15，與 Server 頁同一個面板）。 *@
            <BackgroundJobProgressPanel />
        </OverlayContent>
        <ChildContent>
            <ErrorBoundary>
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div class="app-error-banner" role="alert">這個頁面發生未預期的錯誤，請重新整理頁面；若持續發生請聯絡系統管理員。</div>
                </ErrorContent>
            </ErrorBoundary>
        </ChildContent>
    </AppShell>
}

@code {
    private SessionDto? session;
    private List<MenuItemDto> menu = [];
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // 1.1.49：登入狀態與選單同時發出（以前依序兩次往返，有快取的再次載入因此超過 1.5 秒）。
        // 選單 API 對須改密碼的人也開放（SessionController 整個 [AllowWhenMustChangePassword]）；登入狀態不通過時選單結果直接丟掉。
        var sessionTask = SessionService.GetAsync();
        var menuTask = SessionService.GetMenuAsync();
        var result = await sessionTask;
        if (result.StatusCode == 401)
        {
            return; // ApiClient 已導到登入頁。
        }

        if (!result.Success || result.Data is not { } current)
        {
            // 刪除、停用、沒有角色：照 Blazor Server 頁的做法導到登出頁並帶原因。
            if (result.Data?.Status is { } reason && reason != SessionStatuses.Active)
            {
                NavigationManager.NavigateTo($"/Auths/Logout?reason={Uri.EscapeDataString(reason)}", forceLoad: true, replace: true);
                return;
            }

            errorMessage = $"無法取得登入狀態：{result.ErrorMessage ?? result.Message}";
            return;
        }

        // 須改密碼的帳號一律去變更密碼頁；已經在那頁（1.1.13 起在 WASM）就照常畫出來，不導向自己。
        if (current.MustChangePassword && !IsOnChangePasswordPage())
        {
            NavigationManager.NavigateTo("/ChangePassword", forceLoad: true, replace: true);
            return;
        }

        var menuResult = await menuTask;
        menu = menuResult.Data ?? [];
        session = current;
    }

    private DotNetObjectReference<MeetingRecord.Web.Client.Services.ClientErrorReporter>? clientErrorReporterRef;

    /// <summary>
    /// 登入狀態確認後，把瀏覽器錯誤回報接到 API（1.1.47，client-error-reporter.js）。版面在換頁時不會重建，只註冊一次；
    /// 註冊前發生的錯誤由 JS 暫存、註冊時送出。註冊失敗（腳本沒載入）不影響頁面。
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (session is null || clientErrorReporterRef is not null)
        {
            return;
        }

        clientErrorReporterRef = DotNetObjectReference.Create(ClientErrorReporter);
        try
        {
            await JS.InvokeVoidAsync("meetingRecordClientErrors.register", clientErrorReporterRef);
        }
        catch (JSException)
        {
        }
    }

    private bool IsOnChangePasswordPage()
        => string.Equals("/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0], ApiClient.ChangePasswordPath, StringComparison.OrdinalIgnoreCase);

    /// <summary>AppShell 已檢查過輸入；伺服器會再檢查一次（至少 6 字、support 不可改、目前密碼要對）。成功回 null。</summary>
    private async Task<string?> ChangePasswordAsync(string currentPassword, string newPassword)
    {
        var result = await AccountApi.ChangePasswordAsync(currentPassword, newPassword);
        return result.Success ? null : result.ErrorMessage ?? result.Message;
    }

    private async Task<IReadOnlyList<KeyValuePair<string, string>>> LoadAboutAsync()
    {
        var result = await SystemApi.GetAboutAsync();
        return result.Data is { } about ? AboutItems.From(about) : [new("系統資訊", "目前無法取得，請稍後再試。")];
    }
}
