@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject SessionService SessionService
@inject NotificationApi NotificationApi
@inject AppHubConnection HubConnection
@inject NavigationManager NavigationManager

@* WASM 端的版面：開頁先問 Session API，依結果導向（登入、登出原因、改密碼），通過才畫外框。
   1.1.5 起外框用共用的 AppShell，與 Blazor Server 頁的 MainLayout 同一份外觀；這裡供應 API 來的資料。
   變更密碼與關於在 1.1.6 接上 API 前先不提供（AppShell 遇到 null 就不顯示那個選單項）。 *@
@if (session is null)
{
    <div class="wasm-loading">
        @if (errorMessage is null)
        {
            <Spin Tip="載入中…" />
        }
        else
        {
            <div class="app-error-banner" role="alert">@errorMessage</div>
        }
    </div>
}
else
{
    <AppShell MenuItems="menu"
              SystemName="@SystemName"
              UserDisplayName="@(string.IsNullOrWhiteSpace(session.Name) ? session.Account : session.Name)"
              IsAdmin="session.IsAdmin"
              IsSupportAccount="session.IsSupportAccount">
        <NotificationContent>
            @* 1.1.2：未讀通知數，伺服器推播「通知有變動」就重查。通知清單在 1.1.6 搬通知鈴時接上。 *@
            <span class="wasm-unread" data-count="@unreadCount" aria-label="@($"通知，{unreadCount} 則未讀")">
                <span class="material-icons-outlined" aria-hidden="true">notifications</span>
                <span>@unreadCount</span>
            </span>
        </NotificationContent>
        <ChildContent>
            <ErrorBoundary>
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div class="app-error-banner" role="alert">這個頁面發生未預期的錯誤，請重新整理頁面；若持續發生請聯絡系統管理員。</div>
                </ErrorContent>
            </ErrorBoundary>
        </ChildContent>
    </AppShell>
}

@code {
    private SessionDto? session;
    private List<MenuItemDto> menu = [];
    private string? errorMessage;
    private int unreadCount;

    /// <summary>系統名稱。1.1.6 改由「關於」API 提供；這版先用與設定檔相同的預設名稱。</summary>
    private const string SystemName = "AI 會議記錄小助手";

    protected override async Task OnInitializedAsync()
    {
        var result = await SessionService.GetAsync();
        if (result.StatusCode == 401)
        {
            return; // ApiClient 已導到登入頁。
        }

        if (!result.Success || result.Data is not { } current)
        {
            // 刪除、停用、沒有角色：照 Blazor Server 頁的做法導到登出頁並帶原因。
            if (result.Data?.Status is { } reason && reason != SessionStatuses.Active)
            {
                NavigationManager.NavigateTo($"/Auths/Logout?reason={Uri.EscapeDataString(reason)}", forceLoad: true, replace: true);
                return;
            }

            errorMessage = $"無法取得登入狀態：{result.ErrorMessage ?? result.Message}";
            return;
        }

        if (current.MustChangePassword)
        {
            NavigationManager.NavigateTo("/ChangePassword", forceLoad: true, replace: true);
            return;
        }

        var menuResult = await SessionService.GetMenuAsync();
        menu = menuResult.Data ?? [];
        session = current;

        // 先查一次未讀數再接推播；推播或重連後都重查（斷線期間可能漏掉推播）。
        await RefreshUnreadCountAsync();
        HubConnection.NotificationsChanged += OnNotificationsChangedAsync;
        HubConnection.Reconnected += OnNotificationsChangedAsync;
        await HubConnection.StartAsync();
    }

    private async Task RefreshUnreadCountAsync()
    {
        var result = await NotificationApi.GetUnreadCountAsync();
        if (result.Success)
        {
            unreadCount = result.Data;
        }
    }

    private async Task OnNotificationsChangedAsync()
    {
        await RefreshUnreadCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        HubConnection.NotificationsChanged -= OnNotificationsChangedAsync;
        HubConnection.Reconnected -= OnNotificationsChangedAsync;
        return ValueTask.CompletedTask;
    }
}
