<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- WASM 遷移 M1（1.1.1）：瀏覽器端前端。只能相依 Dtos／Share／Models（架構測試 WebClientArchitectureTests 守門），
       不可參考 Business／AccessDatas／Web（EF Core、檔案存取、伺服器服務）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntDesign" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingRecord.Dtos\MeetingRecord.Dtos.csproj" />
    <ProjectReference Include="..\MeetingRecord.Share\MeetingRecord.Share.csproj" />
  </ItemGroup>

</Project>
