<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- WASM 遷移 M1（1.1.1）：瀏覽器端前端。只能相依 Dtos／Share／Models（架構測試 WebClientArchitectureTests 守門），
       不可參考 Business／AccessDatas／Web（EF Core、檔案存取、伺服器服務）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!-- 1.1.5：找不到元件（少了 @using）時 Razor 只發 RZ10012 警告，元件標籤會被當成普通 HTML 原樣輸出、畫面整塊不見；升級成錯誤。 -->
    <!-- 1.1.37：ClientJsonContext 的 TypeInfoPropertyName 跟型別名稱撞名時只發 SYSLIB1031 警告，執行期整頁炸掉（NoMetadataForType）；升級成錯誤。 -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012;SYSLIB1031</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntDesign" Version="1.6.0" />
    <PackageReference Include="BlazorMaterialIcons" Version="0.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingRecord.Dtos\MeetingRecord.Dtos.csproj" />
    <ProjectReference Include="..\MeetingRecord.Share\MeetingRecord.Share.csproj" />
  </ItemGroup>

</Project>
