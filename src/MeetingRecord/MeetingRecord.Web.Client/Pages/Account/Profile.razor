@page "/Profile"

@using System.ComponentModel.DataAnnotations

@inject SessionService SessionService
@inject AccountApi AccountApi
@inject NavigationManager NavigationManager
@inject MessageService MessageService
@inject NotificationService NotificationService

@* 設定 API 密碼：已有本地密碼才要填「目前密碼」。 *@
<PageTitle>設定 API 密碼</PageTitle>

@if (!string.IsNullOrWhiteSpace(roleMessage))
{
    <div class="alert alert-danger" role="alert">
        @roleMessage
    </div>
}
else if (isLoading)
{
    <Spin />
}
else if (isSupportAccount)
{
    <Alert Type="AlertType.Warning"
           Message="系統預設開發帳號 support 禁止於此變更密碼"
           ShowIcon="true" />
}
else
{
    <div class="profile-page">
        <h1>設定 API 密碼</h1>
        <p class="profile-account">@currentAccount</p>
        <Alert Type="AlertType.Info"
               Message="設定本地 API 密碼後，即可使用「帳號（Email）+ 此密碼」呼叫 /api/v1/auth/login 取得 JWT。"
               Description="網頁登入可繼續使用 Google 單一登入，此密碼僅供 API 存取使用。"
               ShowIcon="true"
               Style="margin-bottom: 20px;" />

        <AntDesign.Form TModel="InputModel"
                        Model="@input"
                        Layout="FormLayout.Vertical"
                        OnFinish="@(_ => OnSubmitAsync())"
                        OnFinishFailed="@(_ => OnValidationFailedAsync())"
                        Context="formContext">
            @if (hasLocalPassword)
            {
                <FormItem Label="目前密碼" Required>
                    <Input Password @bind-Value="input.CurrentPassword" Placeholder="請輸入目前密碼" />
                    <ValidationMessage For="() => input.CurrentPassword" />
                </FormItem>
            }

            <FormItem Label="新密碼" Required>
                <Input Password @bind-Value="input.NewPassword" Placeholder="請輸入新密碼" />
                <ValidationMessage For="() => input.NewPassword" />
            </FormItem>

            <FormItem Label="確認新密碼" Required>
                <Input Password @bind-Value="input.ConfirmPassword" Placeholder="請再次輸入新密碼" />
                <ValidationMessage For="() => input.ConfirmPassword" />
            </FormItem>

            <Space>
                <SpaceItem>
                    <Button Type="ButtonType.Primary" HtmlType="submit" Loading="@isSubmitting">
                        儲存
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button OnClick="@(() => NavigationManager.NavigateTo("/meetings"))" Disabled="@isSubmitting">
                        取消
                    </Button>
                </SpaceItem>
            </Space>
        </AntDesign.Form>
    </div>
}

@code {
    private readonly InputModel input = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private bool isSupportAccount;
    private bool hasLocalPassword;
    private string currentAccount = string.Empty;
    private string roleMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // 登入狀態由 WasmLayout 先處理過；帳號與是不是 support 取自 Session。
        var session = (await SessionService.GetAsync()).Data;
        if (session is null || session.UserId == 0)
        {
            roleMessage = "找不到目前登入使用者資料。";
            isLoading = false;
            return;
        }

        currentAccount = session.Account;
        isSupportAccount = session.IsSupportAccount;
        if (!isSupportAccount)
        {
            hasLocalPassword = (await AccountApi.GetPasswordStatusAsync()).Data?.HasLocalPassword ?? true;
        }

        isLoading = false;
    }

    private async Task OnSubmitAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        try
        {
            var result = await AccountApi.SetApiPasswordAsync(input.CurrentPassword, input.NewPassword, input.ConfirmPassword);
            if (!result.Success)
            {
                if (result.StatusCode == 401)
                {
                    return; // ApiClient 已導到登入頁。
                }

                await NotificationService.Open(new NotificationConfig
                {
                    Message = "設定 API 密碼失敗",
                    Description = result.ErrorMessage ?? result.Message,
                    NotificationType = NotificationType.Error,
                    Placement = NotificationPlacement.BottomRight,
                    Duration = 5
                });
                return;
            }

            await MessageService.SuccessAsync("API 密碼已設定。");
            // 回會議紀錄頁。不必整頁載入：API 密碼不在外框用的登入資料（Session）裡（1.1.56）。
            NavigationManager.NavigateTo("/meetings");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OnValidationFailedAsync()
    {
        await NotificationService.Open(new NotificationConfig
        {
            Message = "設定 API 密碼失敗",
            Description = "請確認密碼欄位皆已正確填寫。",
            NotificationType = NotificationType.Error,
            Placement = NotificationPlacement.BottomRight,
            Duration = 5
        });
    }

    private sealed class InputModel
    {
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "新密碼 不可為空白")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "確認新密碼 不可為空白")]
        [Compare(nameof(NewPassword), ErrorMessage = "新密碼與確認密碼不一致")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
