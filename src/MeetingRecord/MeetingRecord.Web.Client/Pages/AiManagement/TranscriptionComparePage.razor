@page "/transcription-compare"
@using MeetingRecord.Dtos.Diagnostics

@* 轉錄比較（1.1.72）：同一段片段用幾組部署／參數各轉一次並排比較。只限管理者，資料走監控 API。 *@
<PageTitle>轉錄比較</PageTitle>

@if (!isAccessChecked)
{
}
else if (!string.IsNullOrEmpty(RoleMessage))
{
    <div class="compare-empty">@RoleMessage</div>
}
else
{
    <div class="compare-hint">
        同一段片段用幾組語音轉錄部署或參數各轉一次，並排比較。<strong>會產生費用</strong>（記入用量帳本「轉錄比較」），
        不會改動會議本身。部署名稱要先在 Azure 建好，並在設定的單價表（Pricing）有同名項目才算得出費用。
    </div>

    <section class="compare-form">
        <div class="compare-row">
            <label class="compare-label">會議</label>
            <Select TItem="int" TItemValue="int"
                    @bind-Value="meetingId"
                    Placeholder="挑一場有影音檔的會議"
                    EnableSearch
                    Disabled="@isRunning"
                    Style="width: 100%; max-width: 560px;">
                <SelectOptions>
                    @foreach (var meeting in meetings)
                    {
                        <SelectOption TItem="int" TItemValue="int" Value="@meeting.Id" Label="@DescribeMeeting(meeting)" />
                    }
                </SelectOptions>
            </Select>
        </div>

        <div class="compare-row">
            <label class="compare-label">片段</label>
            <span>從第</span>
            <AntDesign.InputNumber TValue="int" @bind-Value="startMinute" Min="0" Disabled="@isRunning" Style="width: 90px;" />
            <span>分鐘開始，長度</span>
            <Select TItem="int" TItemValue="int" @bind-Value="seconds" Disabled="@isRunning" Style="width: 110px;">
                <SelectOptions>
                    @foreach (var option in LengthOptions)
                    {
                        <SelectOption TItem="int" TItemValue="int" Value="@option" Label="@DescribeLength(option)" />
                    }
                </SelectOptions>
            </Select>
            @if (SelectedMeeting?.MediaDurationSeconds is { } total)
            {
                <span class="compare-muted">（整場約 @FormatClock(total)）</span>
            }
        </div>

        <div class="compare-variants">
            @for (var i = 0; i < variants.Count; i++)
            {
                var index = i;
                var variant = variants[index];
                <div class="compare-variant" @key="variant">
                    <span class="compare-variant-no">第 @(index + 1) 組</span>
                    @* 1.1.73：可以選 Azure LLM Speech；它沒有部署、語言、提示詞，改成分講者與講者上限。 *@
                    <Select TItem="int" TItemValue="int" @bind-Value="variant.Engine" Disabled="@isRunning" Style="width: 170px;">
                        <SelectOptions>
                            <SelectOption TItem="int" TItemValue="int" Value="0" Label="Azure OpenAI" />
                            <SelectOption TItem="int" TItemValue="int" Value="1" Label="Azure LLM Speech" Disabled="@(!llmSpeechAvailable)" />
                        </SelectOptions>
                    </Select>
                    @if (variant.Engine == 1)
                    {
                        <span class="compare-variant-field">
                            分講者 <Switch @bind-Value="variant.Diarize" Disabled="@isRunning" />
                        </span>
                        @if (variant.Diarize)
                        {
                            <span class="compare-variant-field">
                                講者上限
                                <AntDesign.InputNumber TValue="int?" @bind-Value="variant.MaxSpeakers" Min="2" Max="35" Disabled="@isRunning" Style="width: 80px;" />
                            </span>
                        }
                        <span class="compare-muted">片語清單自動帶專案名稱與與會人員名冊。</span>
                    }
                    else
                    {
                        <Input TValue="string" @bind-Value="variant.Deployment" Placeholder="部署名稱（空白＝目前設定）" Disabled="@isRunning" Style="width: 240px;" />
                        <Select TItem="string" TItemValue="string" @bind-Value="variant.Language" Disabled="@isRunning" Style="width: 130px;">
                            <SelectOptions>
                                <SelectOption TItem="string" TItemValue="string" Value="@string.Empty" Label="不指定語言" />
                                <SelectOption TItem="string" TItemValue="string" Value="@("zh")" Label="中文（zh）" />
                            </SelectOptions>
                        </Select>
                        <HoverTip Title="@(IsDiarize(variant) ? "diarize 模型不支援提示詞" : "專有名詞，例如產品名、人名，用逗號分隔")">
                            <Input TValue="string" @bind-Value="variant.Prompt" Placeholder="提示詞（選填）"
                                   Disabled="@(isRunning || IsDiarize(variant))" Style="width: 260px;" />
                        </HoverTip>
                    }
                    @if (variants.Count > 1)
                    {
                        <CrudActionButton Title="移除這一組" Icon="close" Disabled="@isRunning" OnClick="@(() => RemoveVariant(index))" />
                    }
                </div>
            }
            @if (variants.Count < TranscriptionCompareRequestDto.MaxVariants)
            {
                <Button Type="ButtonType.Dashed" Disabled="@isRunning" OnClick="AddVariant">
                    <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>加一組</span></span>
                </Button>
            }
        </div>

        <div class="compare-actions">
            <Button Type="ButtonType.Primary" Loading="@isRunning" Disabled="@(meetingId == 0 || isRunning)" OnClick="OnRunAsync">
                <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="compare_arrows" /><span>開始比較</span></span>
            </Button>
            @if (isRunning)
            {
                <Button Type="ButtonType.Default" OnClick="Stop">停止</Button>
                <span class="compare-muted">@progressText</span>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="compare-error">
            <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="error_outline" />
            <span>@errorMessage</span>
        </div>
    }

    @if (audioDataUrl is not null)
    {
        <div class="compare-audio">
            <span>片段原音（@FormatClock(excerptSeconds)）：邊聽邊對照哪一份比較準</span>
            <audio controls src="@audioDataUrl"></audio>
        </div>
    }

    @if (results.Count > 0)
    {
        <div class="compare-results">
            @foreach (var result in results.OrderBy(x => x.Index))
            {
                <div class="compare-result @(result.Success ? string.Empty : "compare-result-failed")" @key="result.Index">
                    <div class="compare-result-head">
                        <strong>第 @(result.Index + 1) 組：@result.Deployment</strong>
                        <span class="compare-muted">@DescribeVariant(result.Index)</span>
                    </div>
                    @if (result.Success)
                    {
                        <div class="compare-result-stats">
                            <span>@result.CharCount 字</span>
                            <span class="@(result.LatinRatio >= 0.1 ? "compare-stat-warn" : string.Empty)">英文 @((result.LatinRatio * 100).ToString("0.#"))%</span>
                            <span>@result.ElapsedSeconds 秒</span>
                            <span>@(result.CostTwd is { } cost ? $"約 NT$ {cost:0.##}" : "費用：—（沒有單價）")</span>
                            <CrudActionButton Title="複製這一份" Icon="content_copy" OnClick="@(() => CopyAsync(result.Text))" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(result.Message))
                        {
                            <div class="compare-result-note">@result.Message</div>
                        }
                        <pre class="compare-result-text">@result.Text</pre>
                    }
                    else
                    {
                        <div class="compare-result-note">@result.Message</div>
                    }
                </div>
            }
        </div>
    }
}
