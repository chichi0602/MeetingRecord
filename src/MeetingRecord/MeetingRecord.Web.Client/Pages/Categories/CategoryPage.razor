@page "/categories"
@using MeetingRecord.Dtos.Models

@* 分類清單（1.1.7 搬到 WASM）：由 Blazor Server 的 CategoryViewView 改寫，畫面、文字、按鈕都不變；資料改走分類 API。 *@
<PageTitle>分類清單</PageTitle>

@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        <div class="category-view-toolbar">
            <div class="category-view-toolbar-left">
                @* 新增、修改、刪除依角色的動作權限顯示（0.4.109；WASM 頁用 PermissionView，規則同伺服器）。 *@
                @if (PermissionView.Can(MagicObjectHelper.角色_分類清單, PermissionActions.Create))
                {
                    <HoverTip Title="新增">
                        <Button Type="ButtonType.Default"
                                OnClick="@(async () => await OnAddAsync())">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增</span></span>
                        </Button>
                    </HoverTip>
                }
                <HoverTip Title="重新整理">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnRefreshAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="refresh" /><span>重新整理</span></span>
                    </Button>
                </HoverTip>
            </div>
            <div class="category-view-toolbar-right">
                <Input class="category-view-search-input" @bind-Value="searchText" BindOnInput="true" DebounceMilliseconds="0" OnPressEnter="@(async () => await OnSearchAsync())" Placeholder="請輸入搜尋關鍵字" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <HoverTip Title="清空搜尋">
                        <Button Type="ButtonType.Default" OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="close" /><span>清空搜尋</span></span>
                        </Button>
                    </HoverTip>
                }
                <HoverTip Title="搜尋">
                    <Button Type="ButtonType.Default" OnClick="@(async () => await OnSearchAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="search" /><span>搜尋</span></span>
                    </Button>
                </HoverTip>
            </div>
        </div>
        <BatchSelectionBar Count="@selectedRows.Count()" Busy="@isBatchDeleting"
                           OnAction="OnBatchDeleteAsync" OnClear="@(() => selectedRows = [])" />
        <div class="category-view-table-wrap">
            <Table @ref="table"
                   TItem="CategoryDto"
                   Class="category-view-table"
                   RemoteDataSource="true"
                   DataSource="@categories"
                   RowKey="x => x.Id"
                   @bind-SelectedRows="selectedRows"
                   OnChange="OnTableChange"
                   @bind-PageIndex="_pageIndex"
                   @bind-PageSize="_pageSize"
                   @bind-Total="_total">
                @if (CanDelete)
                {
                    <Selection />
                }
                <Column TData="string" DataIndex="@nameof(CategoryDto.Name)" Title="名稱" Sortable ShowSorterTooltip="false" />
                <Column TData="string" DataIndex="@nameof(CategoryDto.Description)" Title="描述" />
                <Column TData="string" DataIndex="@nameof(CategoryDto.TeamNamesText)" Title="負責團隊（參考）" />
                <Column TData="bool" DataIndex="@nameof(CategoryDto.IsEnabled)" Title="啟用狀態" Sortable ShowSorterTooltip="false">
                    <StatusToggleTag Enabled="@context.IsEnabled"
                                     Name="@context.Name"
                                     CanToggle="@PermissionView.Can(MagicObjectHelper.角色_分類清單, PermissionActions.Edit)"
                                     OnToggle="@(async () => await OnToggleEnabledAsync(context))" />
                </Column>
                <Column TData="DateTime" DataIndex="@nameof(CategoryDto.UpdatedAt)" Title="更新時間" Sortable ShowSorterTooltip="false" DefaultSortOrder="SortDirection.Descending" />
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                    <Space>
                        @if (PermissionView.Can(MagicObjectHelper.角色_分類清單, PermissionActions.Edit))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="修改" Icon="edit"
                                                  OnClick="@(async () => await OnEditAsync(@context))" />
                            </SpaceItem>
                        }
                        @if (PermissionView.Can(MagicObjectHelper.角色_分類清單, PermissionActions.Delete))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="刪除" Icon="delete" Danger
                                                  OnClick="@(async () => await OnDeleteAsync(@context))" />
                            </SpaceItem>
                        }
                    </Space>
                </ActionColumn>
            </Table>
        </div>
    </div>

    <Modal Title="@modalTitle"
           Class="form-modal-compact"
           @* 單向繫結（1.1.19）：AntDesign 按「確定」時會先送出「關閉」再呼叫 OnOk，用 @bind-Visible 的話伺服器擋下時視窗已經關了、填的內容也不見。開關一律由本頁決定。 *@
           Visible="@modalVisible"
           Keyboard="true"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <div>
            <EditForm Model="@CurrentRecord" Context="editContext" @onkeydown="OnModalKeyDownAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputWatcher EditContextActionChanged="OnEditContestChanged" />

                <AntDesign.Form TModel="CategoryDto" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                    <div class="form-modal-grid">
                        <FormItem Label="名稱" Required>
                            <Input @bind-Value="CurrentRecord.Name" Placeholder="請輸入分類名稱" />
                            <ValidationMessage For="() => CurrentRecord.Name" />
                        </FormItem>

                        <FormItem Label="啟用狀態">
                            <Switch @bind-Value="CurrentRecord.IsEnabled" CheckedChildren="啟用" UnCheckedChildren="停用" />
                        </FormItem>

                        @* 分類＝「什麼資料」。負責團隊只是參考，不會帶進專案，也不影響誰看得到（0.4.102）。 *@
                        <FormItem Label="負責團隊（參考）" Class="form-modal-full">
                            <div @onkeydown:stopPropagation="true">
                                <Select TItem="int" TItemValue="int" Mode="SelectMode.Multiple"
                                        Values="CurrentRecord.TeamIds" OnSelectedItemsChanged="OnTeamsChanged"
                                        Placeholder="通常由哪些團隊負責這類資料（只是參考，不影響誰看得到）"
                                        AllowClear EnableSearch Style="width: 100%;">
                                    @foreach (var t in selectableTeams)
                                    {
                                        <SelectOption TItemValue="int" TItem="int" Value="@t.Id" Label="@t.Name" />
                                    }
                                </Select>
                            </div>
                        </FormItem>

                        <FormItem Label="描述" Class="form-modal-full">
                            <TextArea @bind-Value="CurrentRecord.Description" Rows="4" Placeholder="請輸入分類描述" />
                            <ValidationMessage For="() => CurrentRecord.Description" />
                        </FormItem>
                    </div>
                </AntDesign.Form>
            </EditForm>
        </div>
    </Modal>
}
