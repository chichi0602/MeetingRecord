@page "/meetings"
@using MeetingRecord.Dtos.Jobs
@using MeetingRecord.Dtos.Meetings
@using MeetingRecord.Dtos.Models
@using MeetingRecord.Share.Enums

@* 會議紀錄（1.1.23 搬到 WASM，原 Server 的 MeetingViewView）：畫面、文字、按鈕、確認框全部照舊；
   資料走 MeetingApi，上傳走整個前端共用的 MeetingUploadManager，進度來自 api/v1/jobs＋推播。 *@
<PageTitle>會議紀錄</PageTitle>

@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        <div class="meeting-view-toolbar">
            <div class="meeting-view-toolbar-left">
                @if (CanCreate)
                {
                    <HoverTip Title="新增">
                        <Button Type="ButtonType.Default"
                                OnClick="@(async () => await OnAddAsync())">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增</span></span>
                        </Button>
                    </HoverTip>
                }
                <HoverTip Title="重新整理">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnRefreshAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="refresh" /><span>重新整理</span></span>
                    </Button>
                </HoverTip>
            </div>
            <div class="meeting-view-toolbar-right">
                @* 分類＝「什麼資料」（0.4.102 放回來）；只用來篩選，不影響誰看得到。團隊不放回會議頁：可見性跟著專案走。 *@
                <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                        Values="selectedCategoryFilters" OnSelectedItemsChanged="OnCategoryFilterChanged"
                        Placeholder="分類過濾" AllowClear EnableSearch Style="min-width: 160px;">
                    @foreach (var c in availableCategories)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@c">@c</SelectOption>
                    }
                </Select>
                <Input class="meeting-view-search-input" @bind-Value="searchText" BindOnInput="true" DebounceMilliseconds="0" OnPressEnter="@(async () => await OnSearchAsync())" Placeholder="請輸入搜尋關鍵字" />
                @* 「清空搜尋」放在「搜尋」前面：它有字才出現，放後面會在失焦那一刻把「搜尋」推開、點擊落空（1.1.19 待辦頁踩過）。 *@
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <HoverTip Title="清空搜尋">
                        <Button Type="ButtonType.Default" OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="close" /><span>清空搜尋</span></span>
                        </Button>
                    </HoverTip>
                }
                <HoverTip Title="搜尋">
                    <Button Type="ButtonType.Default" OnClick="@(async () => await OnSearchAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="search" /><span>搜尋</span></span>
                    </Button>
                </HoverTip>
            </div>
        </div>
        <BatchSelectionBar Count="@selectedRows.Count()" Busy="@isBatchDeleting"
                           OnAction="OnBatchDeleteAsync" OnClear="@(() => selectedRows = [])" />
        <div class="meeting-view-table-wrap">
            <Table @ref="table"
                   TItem="MeetingDto"
                   Class="meeting-view-table"
                   RemoteDataSource="true"
                   DataSource="@meetings"
                   RowKey="x => x.Id"
                   @bind-SelectedRows="selectedRows"
                   OnChange="OnTableChange"
                   @bind-PageIndex="_pageIndex"
                   @bind-PageSize="_pageSize"
                   @bind-Total="_total">
                @* 多選刪除（1.0.53）：不能刪的列（不是上傳者或專案負責人、上傳中）勾不起來，表頭全選只選得到能刪的。 *@
                @if (ShowSelection)
                {
                    <Selection Disabled="@(!CanSelect(context))" />
                }
                @* 所屬專案併在標題底下當第二行，不另開一欄——操作欄最多會有 11 顆圖示，能省一欄是一欄。 *@
                <Column TData="string" DataIndex="@nameof(MeetingDto.Title)" Title="會議標題" Sortable ShowSorterTooltip="false">
                    <div class="meeting-title-cell">
                        <span class="meeting-title-name">@context.Title</span>
                        <span class="@(IsUnassigned(context) ? "meeting-title-project meeting-title-project-unassigned" : "meeting-title-project")"
                              title="@ProjectTitleText(context)">@ProjectTitleText(context)</span>
                    </div>
                </Column>
                <Column TData="DateTime?" DataIndex="@nameof(MeetingDto.MeetingDate)" Title="會議日期" Format="yyyy/MM/dd" Sortable ShowSorterTooltip="false" />
                <Column TData="string" Title="分類">@string.Join("、", context.CategoryNames ?? [])</Column>
                <Column TData="string" Title="影音檔">
                    @if (context.HasMedia)
                    {
                        <div class="meeting-media-cell">
                            <span class="meeting-media-name" title="@context.MediaOriginalFileName">@context.MediaOriginalFileName</span>
                            <span class="meeting-media-size">@MeetingMediaPolicy.FormatFileSize(context.MediaFileSize ?? 0)</span>
                        </div>
                    }
                    else
                    {
                        <span class="meeting-media-empty">尚未上傳</span>
                    }
                </Column>
                <Column TData="int" DataIndex="@nameof(MeetingDto.TranscriptionStatus)" Title="轉錄狀態" Sortable ShowSorterTooltip="false">
                    @{
                        var progress = GetLiveProgress(IdOf(context));
                        var transcriptionStatus = (TranscriptionStatus)context.TranscriptionStatus;
                    }
                    @* 上傳中資料庫還是「未上傳」，徽章改看背景工作（1.0.27），百分比接在後面。 *@
                    @if (progress is { IsUploading: true })
                    {
                        <span class="meeting-status meeting-status-processing">上傳中</span>
                    }
                    else
                    {
                        <span class="meeting-status @GetStatusCssClass(transcriptionStatus)">@TranscriptionStatusText.Describe(transcriptionStatus)</span>
                    }
                    @if (progress is not null)
                    {
                        <HoverTip Title="@progress.PhaseText">
                            <span class="meeting-status-percent">@progress.Percent%</span>
                        </HoverTip>
                    }
                    @if (transcriptionStatus == TranscriptionStatus.Failed && !string.IsNullOrWhiteSpace(context.TranscriptionError))
                    {
                        <HoverTip Title="@context.TranscriptionError">
                            <span class="meeting-status-error-hint">⚠</span>
                        </HoverTip>
                    }
                </Column>
                @* Sortable="false"：服務層的排序白名單沒有 DraftStatus，掛上去只會得到一顆按了沒反應的箭頭。 *@
                <Column TData="int" DataIndex="@nameof(MeetingDto.DraftStatus)" Title="會議紀錄" Sortable="false">
                    @{
                        var draftStatus = (DraftStatus)context.DraftStatus;
                        var draftProgress = GetLiveDraftProgress(IdOf(context));
                    }
                    <span class="meeting-status @GetDraftStatusCssClass(draftStatus)">@DraftStatusText.Describe(draftStatus)</span>
                    @if (draftProgress is not null)
                    {
                        <span class="meeting-status-percent">@draftProgress.Percent%</span>
                    }
                    @if (draftStatus == DraftStatus.Failed && !string.IsNullOrWhiteSpace(context.DraftError))
                    {
                        <HoverTip Title="@context.DraftError">
                            <span class="meeting-status-error-hint">⚠</span>
                        </HoverTip>
                    }
                </Column>
                <Column TData="DateTime?" DataIndex="@nameof(MeetingDto.UpdatedAt)" Title="更新時間" Sortable ShowSorterTooltip="false" DefaultSortOrder="SortDirection.Descending" />
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                    @* 上傳在背景跑（1.0.27），只鎖住正在上傳的那一筆，其他紀錄照常操作。
                       看背景工作而不是本頁狀態：別的分頁正在上傳的同一筆也會一起鎖住。
                       「取消上傳」只出現在發起上傳的這個分頁（1.1.23 起上傳由整個前端共用，換過 WASM 頁回來照樣有）；
                       其他分頁可從右下角面板取消（1.0.37）。 *@
                    @if (GetLiveProgress(IdOf(context)) is { IsUploading: true })
                    {
                        @if (UploadManager.IsUploading(IdOf(context)))
                        {
                            <CrudActionButton Title="取消上傳" Icon="cancel" Danger OnClick="@(() => OnCancelUploadAsync(IdOf(context)))" />
                        }
                        else
                        {
                            <span class="meeting-view-row-locked">上傳中</span>
                        }
                    }
                    else
                    {
                    <Space>
                        @* 1.0.40 起只有這一顆：檢視、編修、逐字稿（看／複製／下載）都在視窗裡。
                           以前「檢視」「編修」兩顆並排、圖示又像，使用者覺得操作欄太雜。 *@
                        @if (context.HasDraft || context.HasTranscript)
                        {
                            <SpaceItem>
                                <CrudActionButton Title="會議紀錄與逐字稿" Icon="article"
                                                  OnClick="@(async () => await OnOpenDraftModalAsync(context))" />
                            </SpaceItem>
                        }
                        @* 「AI 轉會議紀錄」1.0.48 起不放在列上：產生與重新產生都從「會議紀錄與逐字稿」視窗裡按。 *@
                        @* 匯出 PDF 的按鈕 0.4.82 起不放在列上：未歸屬的在編修視窗裡按，
                           已歸屬的到專案項目頁按（那裡的 PDF 會帶專案名稱，這裡的不會）。 *@
                        @* 問答的脈絡來自會議紀錄與逐字稿，兩者都沒有時開了也只會得到空脈絡。 *@
                        @if (context.HasDraft || context.HasTranscript)
                        {
                            <SpaceItem>
                                <CrudActionButton Title="AI 問答" Icon="forum"
                                                  OnClick="@(() => OpenMeetingChat(context))" />
                            </SpaceItem>
                        }
                        @* 「抽出待辦」0.4.83 起只留在專案項目頁。待辦在資料表層級就必須有專案，
                           這一頁有一半的會議是未歸屬的，按了也只能跳訊息叫使用者先去歸屬——
                           那不是功能，是一顆騙人的按鈕。歸屬過的會議本來就會出現在專案頁的清單裡。 *@
                        @if (CanEdit)
                        {
                            @* 歸屬不是破壞性動作，不掛 Danger；紅色留給專案頁那顆「從專案移除」。 *@
                            @if (IsUnassigned(context))
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="歸屬到專案" Icon="link"
                                                      OnClick="@(async () => await OnOpenAttachAsync(context))" />
                                </SpaceItem>
                            }
                            @if (context.CanRetryTranscription && context.IsUploader)
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="重新轉錄" Icon="autorenew"
                                              Disabled="@(requeueingMeetingId is not null)"
                                                      OnClick="@(async () => await OnRetryTranscriptionAsync(context))" />
                                </SpaceItem>
                            }
                            <SpaceItem>
                                <CrudActionButton Title="修改" Icon="edit"
                                                  OnClick="@(async () => await OnEditAsync(context))" />
                            </SpaceItem>
                        }
                        @* 1.0.47：刪除只限上傳者與管理者；上傳者是一般使用者（沒有刪除權限）也能刪自己上傳的。
                           能不能刪由 API 依呼叫者算好（MeetingDto.CanDelete），刪除 API 會再檢查一次。 *@
                        @if (context.CanDelete)
                        {
                            <SpaceItem>
                                <CrudActionButton Title="刪除" Icon="delete" Danger
                                                  OnClick="@(async () => await OnDeleteAsync(context))" />
                            </SpaceItem>
                        }
                    </Space>
                    }
                </ActionColumn>
            </Table>
        </div>
    </div>

    @* 單向 Visible（1.1.19）：AntDesign 會在 OnOk 之前先送 VisibleChanged(false)，用 @bind-Visible 的話伺服器擋下時視窗已經關了。 *@
    <Modal Title="@modalTitle"
           Class="meeting-view-modal"
           Visible="@modalVisible"
           Keyboard="@(!IsFormLocked)"
           Closable="@(!IsFormLocked)"
           CancelButtonProps="@(new ButtonProps { Disabled = IsFormLocked })"
           ConfirmLoading="@IsFormLocked"
           MaskClosable="false"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <div>
            <EditForm Model="@CurrentRecord" Context="editContext" @onkeydown="OnModalKeyDownAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputWatcher EditContextActionChanged="OnEditContestChanged" />

                <AntDesign.Form TModel="MeetingDto" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                    <div class="form-modal-grid">
                        <FormItem Label="會議標題" Required>
                            <Input @bind-Value="CurrentRecord.Title" Disabled="@IsFormLocked" Placeholder="請輸入會議標題" />
                            <ValidationMessage For="() => CurrentRecord.Title" />
                        </FormItem>

                        <FormItem Label="會議日期">
                            <div @onkeydown:stopPropagation="true">
                                <DatePicker TValue="DateTime?" @bind-Value="CurrentRecord.MeetingDate" Disabled="@IsFormLocked" AllowClear="true" Style="width: 100%;" />
                            </div>
                            <ValidationMessage For="() => CurrentRecord.MeetingDate" />
                        </FormItem>

                        <FormItem Label="分類" Class="form-modal-full">
                            <div @onkeydown:stopPropagation="true">
                                <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                        Values="CurrentRecord.CategoryNames" OnSelectedItemsChanged="OnRecordCategoriesChanged"
                                        Placeholder="描述會議性質（不影響誰看得到）" AllowClear EnableSearch Disabled="@IsFormLocked" Style="width: 100%;">
                                    @foreach (var c in availableCategories)
                                    {
                                        <SelectOption TItemValue="string" TItem="string" Value="@c">@c</SelectOption>
                                    }
                                </Select>
                            </div>
                        </FormItem>

                        <FormItem Label="描述" Class="form-modal-full">
                            <TextArea @bind-Value="CurrentRecord.Description" Disabled="@IsFormLocked" Rows="3" Placeholder="請輸入會議說明" />
                            <ValidationMessage For="() => CurrentRecord.Description" />
                        </FormItem>

                        <FormItem Label="影音檔" Class="form-modal-full">
                            @* accept 只擋檔案挑選對話框，拖進來的檔案仍要靠 OnMediaFileSelectedAsync
                               裡的 MeetingMediaPolicy.IsAllowedFileName 把關（那一段本來就在）。
                               1.1.23 起上傳開始時 JS 就拿到檔案本身，上傳期間照樣可以在這裡選另一筆的檔案。 *@
                            <FileDropZone @ref="mediaDropZone"
                                          OnChange="OnMediaFileSelectedAsync"
                                          Accept="@MeetingMediaPolicy.AcceptAttribute"
                                          Disabled="@(IsFormLocked || !CanChangeMedia)"
                                          Title="把影音檔拖到這裡，或點擊選擇檔案（一次一個）">
                                @* 「一次一個」要寫出來：單檔模式下一次拖入多個檔案，Chrome 會整個靜默拒絕——
                                   不觸發 change、不報錯，使用者只會覺得「拖進去沒反應」。 *@
                                單檔上限 @MeetingMediaPolicy.FormatFileSize(MeetingMediaPolicy.MaxUploadFileSize)，支援格式：@MeetingMediaPolicy.AllowedExtensionsText。
                                儲存後會自動排入背景轉錄，影片只會取用聲音軌。
                            </FileDropZone>

                            @if (!CanChangeMedia)
                            {
                                <div class="meeting-view-upload-hint">只有上傳者或管理者可以更換影音檔；其他欄位可以照常修改。</div>
                            }

                            @if (pendingMediaFile is not null)
                            {
                                <div class="meeting-view-pending-file">
                                    待上傳：@pendingMediaFile.Name（@MeetingMediaPolicy.FormatFileSize(pendingMediaFile.Size)）
                                    @if (!IsFormLocked)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="ClearPendingMediaFile">移除</button>
                                    }
                                </div>
                            }
                            else if (CurrentRecord.HasMedia)
                            {
                                <div class="meeting-view-pending-file">
                                    目前檔案：@CurrentRecord.MediaOriginalFileName（@MeetingMediaPolicy.FormatFileSize(CurrentRecord.MediaFileSize ?? 0)）
                                    <span class="meeting-view-upload-hint">選擇新檔案會取代現有檔案與逐字稿。</span>
                                </div>
                            }
                            @* 上傳進度與「取消上傳」1.0.27 起移到清單那一列的「轉錄狀態」與操作欄，存檔後視窗就關掉。 *@
                        </FormItem>
                    </div>
                </AntDesign.Form>
            </EditForm>
        </div>
    </Modal>

    <Modal Title="產生會議紀錄"
           Class="form-modal-compact"
           Visible="@draftRequestVisible"
           Keyboard="true"
           MaskClosable="false"
           OkText="@("開始產生")"
           CancelText="@("取消")"
           ConfirmLoading="@isGenerating"
           OnOk="OnDraftRequestOkAsync"
           OnCancel="OnDraftRequestCancelAsync">
        @* 這裡不用 AntDesign.Form／FormItem：那組元件需要一個 TModel，而這個對話框沒有對應的
           資料模型，硬造一個假的只為了排版並不划算。欄位全部整列，本來也用不到兩欄格線。
           keydown 掛在這層原生 div：AntDesign Modal 沒有開放掛載點（Keyboard 只管 Esc）。 *@
        <div class="meeting-draft-request-form" @onkeydown="OnDraftRequestKeyDownAsync">
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">來源逐字稿</span>
                <span class="meeting-draft-request-source">@draftRequestMeetingTitle</span>
            </div>
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">提示詞</span>
                <Select TItem="MeetingPromptOptionDto"
                        TItemValue="int"
                        @key="@($"prompt-{draftRequestOpenCount}")"
                        DataSource="@promptTemplates"
                        @bind-Value="draftRequestPromptTemplateId"
                        LabelName="@nameof(MeetingPromptOptionDto.Name)"
                        ValueName="@nameof(MeetingPromptOptionDto.Id)"
                        EnableSearch
                        Placeholder="選擇要套用的提示詞"
                        Style="width: 100%;" />
            </div>
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">所屬專案（選填）</span>
                <Select TItem="MeetingProjectOptionDto"
                        TItemValue="int"
                        @key="@($"project-{draftRequestOpenCount}")"
                        DataSource="@projects"
                        @bind-Value="draftRequestProjectId"
                        @bind-Value:after="OnDraftRequestProjectChanged"
                        LabelName="@nameof(MeetingProjectOptionDto.Title)"
                        ValueName="@nameof(MeetingProjectOptionDto.Id)"
                        EnableSearch
                        AllowClear
                        Disabled="@draftRequestLockedProject"
                        Placeholder="不指定專案（之後可再歸屬）"
                        Style="width: 100%;" />
            </div>
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">與會人員</span>
                @* @key 同時綁開啟次數與專案 Id：前者讓「關掉再對另一筆開啟」重建元件
                   （用資料 Id 當 key 沒有用，同一筆重開 Id 不變），後者處理對話框開著時換專案。 *@
                <Select TItem="string"
                        TItemValue="string"
                        Mode="SelectMode.Multiple"
                        @key="@($"attendees-{draftRequestOpenCount}-{draftRequestProjectId}")"
                        Values="draftRequestAttendees"
                        OnSelectedItemsChanged="OnDraftRequestAttendeesChanged"
                        Disabled="@(draftRequestProjectId <= 0 || DraftRequestParticipants.Count == 0)"
                        Placeholder="@DraftRequestAttendeePlaceholder"
                        MaxTagCount="3"
                        AllowClear EnableSearch
                        Style="width: 100%;">
                    @foreach (var person in DraftRequestParticipants)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@person">@person</SelectOption>
                    }
                </Select>
            </div>
        </div>
        <p class="meeting-draft-request-note">
            @if (draftRequestLockedProject)
            {
                <span>這份逐字稿已經歸屬專案，重新產生不會變更歸屬。</span>
            }
            else
            {
                <span>不指定專案也可以產生會議紀錄，但不會套用專案的常用名詞校正；之後可以用「歸屬到專案」補上。</span>
            }
        </p>
    </Modal>

    <Modal Title="歸屬到專案"
           Class="form-modal-compact"
           Visible="@attachVisible"
           Keyboard="true"
           MaskClosable="false"
           OkText="@("歸屬")"
           CancelText="@("取消")"
           ConfirmLoading="@isAttaching"
           OnOk="OnAttachOkAsync"
           OnCancel="OnAttachCancelAsync">
        <div class="meeting-draft-request-form" @onkeydown="OnAttachKeyDownAsync">
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">會議紀錄</span>
                <span class="meeting-draft-request-source">@attachMeetingTitle</span>
            </div>
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">歸屬到</span>
                <Select TItem="MeetingProjectOptionDto"
                        TItemValue="int"
                        @key="@($"attach-{attachOpenCount}")"
                        DataSource="@projects"
                        @bind-Value="attachProjectId"
                        LabelName="@nameof(MeetingProjectOptionDto.Title)"
                        ValueName="@nameof(MeetingProjectOptionDto.Id)"
                        EnableSearch
                        Placeholder="選擇專案"
                        Style="width: 100%;" />
            </div>
        </div>
        <p class="meeting-draft-request-note">
            只變更歸屬，不會重新產生會議紀錄，也不會產生任何費用。歸屬後即可抽出待辦事項。
        </p>
    </Modal>

    @* 檢視與編修 0.4.82 起共用同一個視窗，差別只在 CanEdit。
       編修模式是左改右看＋常駐搜尋取代列；唯讀模式只剩右邊的預覽。
       1.0.40 起先開唯讀，按「編修」才切過去（取消、存好都回到檢視）；有逐字稿時唯讀畫面多一個逐字稿頁籤。 *@
    <MarkdownEditorModal @bind-Visible="@draftModalVisible"
                         Title="@draftModalTitle"
                         Content="@draftContent"
                         CanEdit="@draftCanEdit"
                         CanExport="@draftCanExport"
                         IsExporting="@(exportingMeetingId is not null)"
                         IsSaving="@isSavingDraft"
                         Notice="@draftNotice"
                         CanSwitchToEdit="@draftCanSwitchToEdit"
                         OnRequestEdit="OnRequestDraftEdit"
                         OnCancelEdit="OnCancelDraftEdit"
                         CanGenerate="@draftCanGenerate"
                         OnGenerate="OnGenerateFromDraftModalAsync"
                         Transcript="@draftTranscript"
                         CanCopyTranscript="@draftCanCopyTranscript"
                         OnCopyTranscript="OnCopyTranscriptAsync"
                         OnDownloadTranscript="OnDownloadTranscriptAsync"
                         OnExport="OnExportCurrentDraftAsync"
                         OnSave="OnDraftSavedAsync" />

    <AiChatModal @bind-Visible="aiChatVisible"
                 Scope="AiChatScope.Meeting"
                 TargetId="@aiChatTargetId"
                 Title="@aiChatTitle"
                 CanExport="@CanExport"
                 CanEdit="@CanEdit"
                 CanDelete="@PermissionView.Can(MagicObjectHelper.角色_會議紀錄, PermissionActions.Delete)" />
}
