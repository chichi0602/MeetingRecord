@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MeetingRecord.Web.styles.css"]" />
    <ImportMap />
    @* SVG 優先；不支援 SVG favicon 的舊瀏覽器才會退回 png。
       走 @Assets 是必要的——favicon 的瀏覽器快取極頑固，沒有 fingerprint 的話
       換了圖也會繼續顯示舊的（0.4.41 就是這樣，改完仍看到樣板的紫色圖示）。 *@
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    @if (IsWasmPage)
    {
        <HeadOutlet @rendermode="WasmRenderMode" />
    }
    else
    {
        <HeadOutlet />
    }

    @* 1.1.49：AntDesign 的樣式與腳本改走 @Assets，取得指紋網址與永久快取（以前每次載入都要向伺服器確認有沒有更新）。 *@
    <link href="@Assets["_content/AntDesign/css/ant-design-blazor.css"]" rel="stylesheet">

    @* 1.1.49：先跟字型網域建立連線，圖示字型的 CSS 與字型檔才不會排在最後。 *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css?family=Material+Icons|Material+Icons+Outlined|Material+Icons+Sharp|Material+Icons+Round|Material+Icons+Two+Tone" rel="stylesheet">

</head>

<body>
    @* 只有 ServerPageRoutes 列的登入、登出、錯誤頁由伺服器靜態算繪（1.1.45），其餘全部是瀏覽器端 ClientRoutes 的 WASM 頁。 *@
    @if (IsWasmPage)
    {
        @* 1.1.58：WASM 跑起來之前的載入畫面（純 HTML／CSS，那時還沒有 AntDesign）。第一次開要下載好幾 MB，
           以前這段時間一片空白。WasmLayout 拿到登入狀態後呼叫 meetingRecordAppLoading.hide 移除；
           百分比是 blazor.web.js 設定的 --blazor-load-percentage-text；超過 20 秒顯示提示（app-loading.js）。 *@
        <div id="app-loading" class="app-loading" role="status" aria-live="polite">
            <div class="app-loading-name">@SystemName</div>
            <div class="app-loading-spinner" aria-hidden="true"></div>
            <div class="app-loading-text">系統載入中，第一次開啟需要較長時間，請稍候…</div>
            <div class="app-loading-percent" aria-hidden="true"></div>
            <div class="app-loading-hint" hidden>
                <p>載入時間比平常久，請確認網路連線；若一直沒有反應，請重新整理頁面或聯絡系統管理員。</p>
                <button type="button" class="app-loading-reload" onclick="location.reload()">重新整理</button>
            </div>
        </div>
        <script src="@Assets["js/app-loading.js"]"></script>
        <MeetingRecord.Web.Client.ClientRoutes @rendermode="WasmRenderMode" />
    }
    else
    {
        <Routes />
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>

    <script src="@Assets["_content/AntDesign/js/ant-design-blazor.js"]"></script>
    <script antblazor-js></script>

    <script src="@Assets["js/download.js"]"></script>
    <script src="@Assets["js/clipboard.js"]"></script>
    <script src="@Assets["js/text-editor.js"]"></script>
    <script src="@Assets["js/todo-auto-fit.js"]"></script>
    <script src="@Assets["js/chat-attach.js"]"></script>
    <script src="@Assets["js/chat-scroll.js"]"></script>
    <script src="@Assets["js/client-error-reporter.js"]"></script>
    <script src="@Assets["js/hover-tip.js"]"></script>
    <script src="@Assets["js/help-view.js"]"></script>
    <script src="@Assets["js/chunk-upload.js"]"></script>
</body>

</html>
