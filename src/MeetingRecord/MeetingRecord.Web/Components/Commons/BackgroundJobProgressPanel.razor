@if (visibleJobs.Count > 0)
{
    <div class="job-progress-panel @(isCollapsed ? "job-progress-panel-collapsed" : string.Empty)">
        <div class="job-progress-panel-header">
            <span class="job-progress-panel-title">@HeaderText</span>
            <div class="job-progress-panel-header-actions">
                <button type="button"
                        class="job-progress-panel-icon-button"
                        aria-label="@(isCollapsed ? "展開" : "收合")"
                        @onclick="ToggleCollapsed">
                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@(isCollapsed ? "expand_less" : "expand_more")" />
                </button>
                <button type="button"
                        class="job-progress-panel-icon-button"
                        aria-label="全部關閉"
                        @onclick="DismissAll">
                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="close" />
                </button>
            </div>
        </div>

        @if (!isCollapsed)
        {
            <div class="job-progress-panel-body">
                @foreach (var job in visibleJobs)
                {
                    <div class="job-progress-panel-row" @key="job.Key">
                        <div class="job-progress-panel-row-head">
                            <span class="job-progress-panel-kind" title="@job.KindText">
                                <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@job.KindIcon" />
                            </span>
                            <span class="job-progress-panel-name" title="@job.Title">@job.Title</span>
                            @if (job.IsCompleted)
                            {
                                <span class="job-progress-panel-done" aria-label="已完成">
                                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="check_circle" />
                                </span>
                            }
                            else if (job.IsFailed)
                            {
                                <Tooltip Title="@job.ErrorMessage">
                                    <span class="job-progress-panel-failed" aria-label="失敗">
                                        <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="error" />
                                    </span>
                                </Tooltip>
                            }
                            else
                            {
                                <span class="job-progress-panel-percent">@job.Percent%</span>
                            }
                            <button type="button"
                                    class="job-progress-panel-icon-button job-progress-panel-row-close"
                                    aria-label="關閉這一筆"
                                    @onclick="@(() => Dismiss(job))">
                                <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="close" />
                            </button>
                        </div>

                        <Progress Type="ProgressType.Line"
                                  Size="ProgressSize.Small"
                                  Percent="job.Percent"
                                  Status="@job.ProgressStatus"
                                  ShowInfo="false" />

                        <div class="job-progress-panel-phase">@job.KindText · @job.PhaseText</div>
                    </div>
                }
            </div>
        }
    </div>
}
