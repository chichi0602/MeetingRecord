@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@* 清單「操作」欄的按鈕：畫面上只有圖示，用途靠 Tooltip 表達（0.4.62）。
   .crud-action-button-label 是 clip 隱藏的無障礙標籤——看不見，但螢幕閱讀器
   讀得到，也是 <Button> 那一支唯一的可及名稱。不要因為「反正看不見」就刪掉它。

   有外框的按鈕（工具列、對話框）規則相反，一律要有可見文字；
   兩類的分界寫在 docs/architecture/開發慣例與限制速查.md 的 UI 慣例。

   外層這個 span 不是裝飾，是為了讓 scoped CSS 有東西可選：Tooltip 與 Button 都是
   子元件，scope 屬性不會傳進去，`.crud-action-button {}` 會被編成
   `.crud-action-button[b-xxx]` 而永遠選不到（<a> 那一支是自己寫的所以本來有效，
   <Button> 那一支則整段是死的）。從這個 span 用 ::deep 選進去，兩支都涵蓋。 *@
<span class="crud-action-button-host">
    <Tooltip Title="@Title">
        @if (!string.IsNullOrWhiteSpace(Href))
        {
            <a class="@CssClass"
               href="@Href"
               target="@Target"
               title="@Title"
               aria-label="@Title">
                <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@Icon" />
                <span class="crud-action-button-label">@Title</span>
            </a>
        }
        else
        {
            <Button Type="ButtonType.Default"
                    Class="@CssClass"
                    Disabled="@Disabled"
                    OnClick="HandleClickAsync">
                <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@Icon" />
                <span class="crud-action-button-label">@Title</span>
            </Button>
        }
    </Tooltip>
</span>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string Target { get; set; } = "_blank";

    [Parameter]
    public bool Danger { get; set; }

    private string CssClass => Danger
        ? "crud-action-button crud-action-button-danger"
        : "crud-action-button";

    private Task HandleClickAsync(MouseEventArgs args)
        => OnClick.InvokeAsync();
}
