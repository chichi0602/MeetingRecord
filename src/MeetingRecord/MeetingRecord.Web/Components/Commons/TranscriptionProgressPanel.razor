@using MeetingRecord.Business.Services.Transcription

@if (visibleItems.Count > 0)
{
    <div class="transcription-panel @(isCollapsed ? "transcription-panel-collapsed" : string.Empty)">
        <div class="transcription-panel-header">
            <span class="transcription-panel-title">@HeaderText</span>
            <div class="transcription-panel-header-actions">
                <button type="button"
                        class="transcription-panel-icon-button"
                        aria-label="@(isCollapsed ? "展開" : "收合")"
                        @onclick="ToggleCollapsed">
                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@(isCollapsed ? "expand_less" : "expand_more")" />
                </button>
                <button type="button"
                        class="transcription-panel-icon-button"
                        aria-label="全部關閉"
                        @onclick="DismissAll">
                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="close" />
                </button>
            </div>
        </div>

        @if (!isCollapsed)
        {
            <div class="transcription-panel-body">
                @foreach (var item in visibleItems)
                {
                    <div class="transcription-panel-row" @key="item.MeetingId">
                        <div class="transcription-panel-row-head">
                            <span class="transcription-panel-name" title="@item.Title">@item.Title</span>
                            @if (item.Phase == TranscriptionPhase.Completed)
                            {
                                <span class="transcription-panel-done" aria-label="已完成">
                                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="check_circle" />
                                </span>
                            }
                            else if (item.Phase == TranscriptionPhase.Failed)
                            {
                                <Tooltip Title="@item.ErrorMessage">
                                    <span class="transcription-panel-failed" aria-label="失敗">
                                        <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="error" />
                                    </span>
                                </Tooltip>
                            }
                            else
                            {
                                <span class="transcription-panel-percent">@item.Percent%</span>
                            }
                            <button type="button"
                                    class="transcription-panel-icon-button transcription-panel-row-close"
                                    aria-label="關閉這一筆"
                                    @onclick="@(() => Dismiss(item.MeetingId))">
                                <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="close" />
                            </button>
                        </div>

                        <Progress Type="ProgressType.Line"
                                  Size="ProgressSize.Small"
                                  Percent="item.Percent"
                                  Status="@ResolveProgressStatus(item)"
                                  ShowInfo="false" />

                        <div class="transcription-panel-phase">@DescribePhase(item)</div>
                    </div>
                }
            </div>
        }
    </div>
}
