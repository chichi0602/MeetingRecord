@inherits LayoutComponentBase

@* ⚠️ 擋掉「拖到頁面空白處」的預設行為：瀏覽器會直接導航去開那個檔案，
   Blazor 的 circuit 跟著死，填到一半的表單整份不見。有了拖放區之後這會變成常見誤操作。
   只設 preventDefault、不接 handler：接了的話 dragover 每幾十毫秒就往返伺服器一次。
   拖放區本身不受影響——它的 input 是 drop 的實際目標，這裡攔的是沒命中任何 input 的那些。 *@
<div class="page @(isSidebarCollapsed ? "sidebar-collapsed" : string.Empty)"
     @ondragover:preventDefault="true"
     @ondrop:preventDefault="true">
    <div class="sidebar">
        <NavMenu IsSidebarCollapsed="isSidebarCollapsed" />
    </div>

    @* 收合鈕放在 .sidebar 外面而不是裡面：.sidebar 有 overflow: hidden，
       擺在內部就沒辦法讓按鈕跨出邊界。定位靠 .page 上的 --sidebar-width。 *@
    <button type="button"
            class="sidebar-toggle-edge"
            @onclick="ToggleSidebar"
            aria-label="切換側邊欄"
            aria-expanded="@(!isSidebarCollapsed)"
            title="@(isSidebarCollapsed ? "展開側邊欄" : "收起側邊欄")">
        <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                      Kind="@(isSidebarCollapsed ? "chevron_right" : "chevron_left")" />
    </button>

    <main>
        <div class="top-row px-4">
            <div class="top-row-title">@CurrentPageTitle</div>
            <div class="top-row-status">
                <div class="user-menu @(isUserMenuOpen ? "user-menu-open" : string.Empty)">
                    <button type="button"
                            class="user-menu-trigger"
                            aria-label="使用者操作"
                            aria-expanded="@isUserMenuOpen"
                            aria-haspopup="menu"
                            @onclick="ToggleUserMenu">
                        <span class="user-menu-icon" aria-hidden="true">
                            <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="account_circle" />
                        </span>
                        <span class="user-menu-text">
                            <span class="user-menu-name">@CurrentUserDisplayName</span>
                            @if (CurrentUserIsAdmin)
                            {
                                <span class="user-menu-badge">管理員</span>
                            }
                        </span>
                        <span class="user-menu-caret" aria-hidden="true">
                            <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="expand_more" />
                        </span>
                    </button>

                    <div class="user-menu-dropdown @(isUserMenuOpen ? "user-menu-dropdown-open" : string.Empty)"
                         role="menu"
                         aria-label="使用者操作">
                        <button type="button" class="user-menu-item" role="menuitem" @onclick="OnChangePasswordClick">變更密碼</button>
                        <a class="user-menu-item" href="/Profile" role="menuitem">設定 API 密碼</a>
                        <button type="button" class="user-menu-item" role="menuitem" @onclick="OnAboutClick">關於</button>
                        <a class="user-menu-item" href="/Auths/Logout" role="menuitem">登出</a>
                    </div>
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<Modal Title="變更密碼"
       Class="change-password-modal form-modal-compact"
       @bind-Visible="@changePasswordVisible"
       Keyboard="true"
       OnOk="OnChangePasswordOkAsync"
       OnCancel="OnChangePasswordCancelAsync"
       OkText="@("確認變更")"
       CancelText="@("取消")">
    @if (isSupportAccount)
    {
        <AntDesign.Alert Message="系統預設帳號 support 不允許變更密碼。" Type="@AntDesign.AlertType.Warning" ShowIcon="true" />
    }
    else
    {
        @* AntDesign Modal 沒有開放 keydown 掛載點（Keyboard 參數只管 Esc），
           所以包一層原生 div 來接。密碼欄不會觸發輸入法，是最安全的 Enter 送出情境。 *@
        <div @onkeydown="OnChangePasswordKeyDownAsync">
            <AntDesign.Form TModel="ChangePasswordForm" Model="@changePasswordForm" Layout="FormLayout.Vertical">
                <FormItem Label="目前密碼" Required>
                    <InputPassword @bind-Value="changePasswordForm.CurrentPassword" Placeholder="請輸入目前密碼" />
                </FormItem>
                <FormItem Label="新密碼" Required>
                    <InputPassword @bind-Value="changePasswordForm.NewPassword" Placeholder="請輸入新密碼（至少 6 個字元）" />
                </FormItem>
                <FormItem Label="確認新密碼" Required>
                    <InputPassword @bind-Value="changePasswordForm.ConfirmPassword" Placeholder="請再次輸入新密碼" />
                </FormItem>
                @if (!string.IsNullOrEmpty(changePasswordErrorMessage))
                {
                    <AntDesign.Alert Message="@changePasswordErrorMessage" Type="@AntDesign.AlertType.Error" ShowIcon="true" />
                }
            </AntDesign.Form>
        </div>
    }
</Modal>

<Modal Title="關於"
       Class="about-modal"
       Width="520"
       @bind-Visible="@aboutVisible"
       Keyboard="true"
       Footer="null"
       OnCancel="OnAboutCancel">
    <dl class="about-list">
        @foreach (var item in aboutItems)
        {
            <div class="about-row">
                <dt class="about-term">@item.Key</dt>
                <dd class="about-value">@item.Value</dd>
            </div>
        }
    </dl>
</Modal>

@* 變更密碼與關於視窗都在這個 layout 裡，外框樣式同樣要靠 FormModalHelper 的全域 <style>。
   ⚠️ 0.4.69 之前這裡沒有 render 它，所以 .change-password-modal 那條規則從來沒生效過。 *@
<FormModalHelper />

@* 常駐於所有頁面：轉錄與會議紀錄生成都是背景工作，離開來源頁面也要看得到進度。 *@
<BackgroundJobProgressPanel />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">關閉</span>
</div>
