@* 收合鈕已於 0.4.44 移到 MainLayout，浮在側邊欄的右邊界上，這裡只剩品牌識別。 *@
<div class="top-row navbar-dark @(IsSidebarCollapsed ? "top-row-collapsed" : string.Empty)">
    <div class="sidebar-brand @(IsSidebarCollapsed ? "sidebar-brand-collapsed" : string.Empty)">
        <div class="sidebar-brand-icon" aria-hidden="true">
            @* 與登入頁同一份標誌（也是 wwwroot/favicon.svg）。
               以 currentColor 描邊，顏色跟著文字走。 *@
            @* viewBox 收緊到圖形的實際邊界（含 stroke 與四個圓點約落在 5～115），
               原本的 0 0 120 120 四周各留了一圈空白，圖看起來會比實際尺寸小。 *@
            <svg viewBox="5 5 110 110" role="img">
                <g fill="none" stroke="currentColor" stroke-width="6">
                    <ellipse cx="60" cy="60" rx="52" ry="26" />
                    <ellipse cx="60" cy="60" rx="52" ry="26" transform="rotate(60 60 60)" />
                    <ellipse cx="60" cy="60" rx="52" ry="26" transform="rotate(120 60 60)" />
                </g>
                <g fill="currentColor">
                    <circle cx="34" cy="15" r="8" />
                    <circle cx="86" cy="15" r="8" />
                    <circle cx="34" cy="105" r="8" />
                    <circle cx="86" cy="105" r="8" />
                </g>
                <text x="60" y="60" text-anchor="middle" dominant-baseline="central"
                      font-family="'Segoe UI', system-ui, sans-serif" font-size="36" font-weight="700"
                      fill="currentColor">AI</text>
            </svg>
        </div>
        <div class="sidebar-brand-text">
            @* 系統名稱以設定檔為單一來源，不寫死。 *@
            <a class="navbar-brand" href="">@SystemName</a>
            <div class="navbar-subtitle">管理後台功能清單</div>
        </div>
    </div>
</div>

<div class="nav-scrollable @(IsSidebarCollapsed ? "nav-scrollable-collapsed" : string.Empty)">
    <div class="sidebar-menu-shell @(IsSidebarCollapsed ? "sidebar-menu-shell-collapsed" : string.Empty)">
        @if (MenuItems.Count == 0)
        {
            <div class="nav-section-title">功能選單</div>
            <div class="nav-item px-3">
                <span class="nav-link nav-link-disabled">尚無可用選單</span>
            </div>
        }
        else if (IsSidebarCollapsed)
        {
            @for (var sectionIndex = 0; sectionIndex < Sections.Count; sectionIndex++)
            {
                var section = Sections[sectionIndex];

                @if (sectionIndex > 0)
                {
                    @* 收合態的區塊標題被 CSS 隱藏，改用分隔線維持視覺分區 *@
                    <div class="collapsed-section-divider" aria-hidden="true"></div>
                }

                <div class="nav-section-title">@section.Name</div>
                <nav class="collapsed-sidebar-menu" aria-label="@section.Name">
                    <ul class="collapsed-menu-list">
                        @foreach (var entry in section.Entries)
                        {
                            var item = entry.Item;
                            @* ItemKey 一律用該項在完整 MenuItems 中的原始索引，
                               分區只影響渲染順序，不影響選取狀態的鍵值計算。 *@
                            var itemKey = $"root-{entry.Index}";

                            <li class="@GetCollapsedItemClass(itemKey)">
                                @if (item.HasChildren)
                                {
                                    <button type="button"
                                            class="collapsed-menu-trigger"
                                            aria-label="@item.Name"
                                            aria-haspopup="menu"
                                            title="@item.Name">
                                        <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@GetMaterialIconKind(item)" />
                                    </button>

                                    <div class="collapsed-menu-flyout" role="menu" aria-label="@item.Name">
                                        @for (var childIndex = 0; childIndex < item.SubMenu.Count; childIndex++)
                                        {
                                            var child = item.SubMenu[childIndex];
                                            var childKey = $"{itemKey}-{childIndex}";

                                            @if (!string.IsNullOrWhiteSpace(child.Url))
                                            {
                                                <a class="@GetCollapsedFlyoutItemClass(childKey)"
                                                   href="@child.Url"
                                                   role="menuitem">
                                                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@GetMaterialIconKind(child)" />
                                                    <span>@child.Name</span>
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.Url))
                                {
                                    <a class="collapsed-menu-trigger collapsed-menu-link"
                                       href="@item.Url"
                                       aria-label="@item.Name"
                                       title="@item.Name">
                                        <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@GetMaterialIconKind(item)" />
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            @for (var sectionIndex = 0; sectionIndex < Sections.Count; sectionIndex++)
            {
                var section = Sections[sectionIndex];

                <div class="nav-section-title @(sectionIndex > 0 ? "nav-section-title-subsequent" : string.Empty)">
                    @section.Name
                </div>
                <Menu Class="sidebar-menu"
                      Mode="MenuMode.Inline"
                      Theme="MenuTheme.Light"
                      InlineCollapsed="false"
                      SelectedKeys="SelectedKeys"
                      OpenKeys="OpenKeys"
                      OpenKeysChanged="HandleOpenKeysChanged">
                    @foreach (var entry in section.Entries)
                    {
                        <SidebarMenuNode Item="entry.Item"
                                         ItemKey="@($"root-{entry.Index}")" />
                    }
                </Menu>
            }
        }
    </div>
</div>
