@using System.Globalization
@using MeetingRecord.Web.Diagnostics
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager
@inject MeetingRecord.Web.Uploads.BrowserFileUploader BrowserFileUploader
@inject ModalService ModalService

@code {
    /// <summary>浮層（對話窗、通知）的錯誤邊界；換頁時復原，讓對話窗與通知重新可用。</summary>
    private LoggingErrorBoundary? overlayBoundary;

    private IDisposable? locationChangingRegistration;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        locationChangingRegistration = NavigationManager.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    /// <summary>
    /// 1.1.6（WASM 遷移）：往 WASM 頁是整頁載入，這條連線一斷，還在上傳的影音檔或附件就中斷了。
    /// Server 頁之間切換不會斷（同一條連線），所以只攔往 WASM 頁、而且有上傳進行中的導覽。
    /// </summary>
    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (BrowserFileUploader.ActiveUploadCount == 0)
        {
            return;
        }

        var path = "/" + NavigationManager.ToBaseRelativePath(context.TargetLocation).Split('?', '#')[0];
        if (!MeetingRecord.Share.Helpers.WasmRoutes.IsWasm(path))
        {
            return;
        }

        var leave = await ModalService.ConfirmAsync(new ConfirmOptions
        {
            Title = "上傳還在進行",
            Content = "影音檔或附件還在上傳，離開這頁會中斷上傳。確定要離開嗎？",
            OkText = "離開",
            CancelText = "留下",
        });

        if (!leave)
        {
            context.PreventNavigation();
            return;
        }

        // 已確認要離開：拿掉 beforeunload，免得接著整頁載入時瀏覽器再問一次。
        await BrowserFileUploader.ReleaseLeaveGuardAsync();
    }

    protected override void OnParametersSet()
    {
        LocaleProvider.SetLocale(CultureInfo.CurrentUICulture.Name);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() => overlayBoundary?.Recover());
    }

    private void ReloadPage() => NavigationManager.Refresh(forceReload: true);

    /// <summary>
    /// 1.1.1（WASM 遷移 M1）：要去的頁面已改在瀏覽器執行（WasmRoutes），交給伺服器整頁載入；
    /// 這個 Router 只認得 Blazor Server 頁，不攔的話會顯示找不到頁面。
    /// </summary>
    private Task OnNavigateAsync(NavigationContext context)
    {
        if (MeetingRecord.Share.Helpers.WasmRoutes.IsWasm("/" + context.Path))
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true, replace: true);
        }

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        locationChangingRegistration?.Dispose();
    }
}

@* 0.4.122 起兩層錯誤邊界（移植自 NET10-Blazor-Starter）：內建 ErrorBoundary 不會記錄任何東西，
   LoggingErrorBoundary 會把例外記下來（進系統例外紀錄，來源「畫面」），並把錯誤追蹤碼顯示給使用者。 *@
<ConfigProvider>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            <LoggingErrorBoundary>
                <ChildContent>
                    <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </ChildContent>
                <ErrorContent Context="exception">
                    <div class="app-error-banner" role="alert">
                        <b>這個頁面發生未預期的錯誤。</b>
                        錯誤已記錄，請<a href="" @onclick="ReloadPage" @onclick:preventDefault>重新整理頁面</a>；若持續發生請聯絡系統管理員@TraceCode.Suffix(TraceCode.FromException(exception))。
                    </div>
                </ErrorContent>
            </LoggingErrorBoundary>
        </Found>
    </Router>

    <LoggingErrorBoundary @ref="overlayBoundary">
        <ChildContent>
            <AntContainer />
        </ChildContent>
        <ErrorContent Context="exception">
            <div class="app-error-banner app-error-banner-overlay" role="alert">
                <b>畫面元件發生錯誤，已記錄。</b>
                請<a href="" @onclick="ReloadPage" @onclick:preventDefault>重新整理頁面</a>；若持續發生請聯絡系統管理員@TraceCode.Suffix(TraceCode.FromException(exception))。
            </div>
        </ErrorContent>
    </LoggingErrorBoundary>
</ConfigProvider>
