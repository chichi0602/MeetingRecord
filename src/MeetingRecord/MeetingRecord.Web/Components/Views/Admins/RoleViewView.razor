@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{

    <div>
        <div class="role-view-toolbar">
            <div class="role-view-toolbar-left">
                <Tooltip Title="新增">
                    <Button Type="ButtonType.Default"
                    OnClick="@(async()=>await OnAddAsync(true))">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增</span></span>
                    </Button>
                </Tooltip>
                <Tooltip Title="重新整理">
                    <Button Type="ButtonType.Default"
                    OnClick="@(async () => await OnRefreshAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="refresh" /><span>重新整理</span></span>
                    </Button>
                </Tooltip>
            </div>
            <div class="role-view-toolbar-right">
                <Input class="role-view-search-input" @bind-Value="searchText" Placeholder="請輸入搜尋關鍵字" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <Tooltip Title="清空搜尋">
                        <Button Type="ButtonType.Default" OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="close" /><span>清空搜尋</span></span>
                        </Button>
                    </Tooltip>
                }
                <Tooltip Title="搜尋">
                    <Button Type="ButtonType.Default" OnClick="@(async () => await OnSearchAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="search" /><span>搜尋</span></span>
                    </Button>
                </Tooltip>
            </div>
        </div>
        <div class="role-view-table-wrap">
            <Table @ref="table"
            TItem="RoleViewAdapterModel"
            Class="role-view-table"
            RemoteDataSource="true"
            DataSource="@roleViewAdapterModels"
            OnChange=OnTableChange
            @bind-PageIndex="_pageIndex"
            @bind-PageSize="_pageSize"
            @bind-Total=_total>
                <Column TData="string" DataIndex="@nameof(RoleViewAdapterModel.Name)" Title="名稱" Sortable DefaultSortOrder="SortDirection.Ascending" />
                <Column TData="DateTime" DataIndex="@nameof(RoleViewAdapterModel.CreateAt)" Title="建立時間" Sortable DefaultSortOrder="SortDirection.Ascending" />
                <Column TData="DateTime" DataIndex="@nameof(RoleViewAdapterModel.UpdateAt)" Title="更新時間" Sortable DefaultSortOrder="SortDirection.Ascending" />
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                    <Space>
                        <SpaceItem>
                            <CrudActionButton Title="修改" Icon="edit"
                                              OnClick="@(async () => await OnEditAsync(@context))" />
                        </SpaceItem>
                        <SpaceItem>
                            <CrudActionButton Title="刪除" Icon="delete" Danger
                                              OnClick="@(async () => await OnDeleteAsync(@context))" />
                        </SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </div>
    </div>

    <Modal Title="@modalTitle"
    Class="role-view-modal form-modal-large"
    @bind-Visible="@modalVisible"
    Keyboard="true"
    OnOk="OnModalOKHandleAsync"
    OnCancel="OnModalCancelHandleAsync">
        <div class="">
            <EditForm Model="@CurrentRecord" Context="editContext" @onkeydown="OnModalKeyDownAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputWatcher EditContextActionChanged="OnEditContestChanged" />

                <AntDesign.Form TModel="RoleViewAdapterModel" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                    <div class="form-modal-grid">
                        <FormItem Label="名稱" Required>
                            <Input @bind-Value="CurrentRecord.Name" Placeholder="請輸入名稱" />
                            <ValidationMessage For="() => CurrentRecord.Name" />
                        </FormItem>

                        <FormItem Label="預設團隊">
                            <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                    Values="CurrentRecord.DefaultTeams" OnSelectedItemsChanged="OnRoleTeamsChanged"
                                    Placeholder="選擇此角色可瀏覽的團隊（不設定表示僅能看到無團隊的公開紀錄）"
                                    AllowClear EnableSearch Style="width: 100%;">
                                @foreach (var t in availableTeams)
                                {
                                    <SelectOption TItemValue="string" TItem="string" Value="@t">@t</SelectOption>
                                }
                            </Select>
                        </FormItem>

                        @* 權限矩陣跨整列：54 個核取方塊壓成半欄會擠成一團。 *@
                        <FormItem Label="角色項目" Class="form-modal-full">
                            <FormItem>
                                @foreach (var group in CurrentRecord.RolePermission.Groups)
                                {
                                    <div class="role-permission-group">
                                        <Checkbox Checked="@group.Enable" CheckedChanged="@(value => OnPermissionGroupChanged(group, value))">
                                            @group.Name
                                        </Checkbox>

                                        @if (group.Permissions.Count > 0)
                                        {
                                            <div class="role-permission-children">
                                                @foreach (var role in group.Permissions)
                                                {
                                                    <div class="role-permission-node">
                                                        <Checkbox Checked="@role.Enable" CheckedChanged="@(value => OnPermissionItemChanged(group, role, value))">
                                                            @role.Name（全部）
                                                        </Checkbox>
                                                        <span class="role-permission-actions">
                                                            @foreach (var action in PermissionActionItems)
                                                            {
                                                                <Checkbox Disabled="@role.Enable"
                                                                          Checked="@GetActionChecked(role, action.Key)"
                                                                          CheckedChanged="@(value => OnPermissionActionChanged(group, role, action.Key, value))">
                                                                    @action.Label
                                                                </Checkbox>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </FormItem>
                        </FormItem>
                    </div>
                </AntDesign.Form>
            </EditForm>
        </div>
    </Modal>
}

<FormModalHelper />
