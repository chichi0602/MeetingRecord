@using MeetingRecord.Share.Helpers
@using MeetingRecord.Share.Enums
@using MeetingRecord.Business.Helpers
@using MeetingRecord.Business.Services.AiChat
@using MeetingRecord.Web.Components.Views.Projects
@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        <div class="meeting-view-toolbar">
            <div class="meeting-view-toolbar-left">
                @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_會議紀錄, PermissionActions.Create))
                {
                    <Tooltip Title="新增">
                        <Button Type="ButtonType.Default"
                                OnClick="@(async () => await OnAddAsync())">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增</span></span>
                        </Button>
                    </Tooltip>
                }
                <Tooltip Title="重新整理">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnRefreshAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="refresh" /><span>重新整理</span></span>
                    </Button>
                </Tooltip>
            </div>
            <div class="meeting-view-toolbar-right">
                <Input class="meeting-view-search-input" @bind-Value="searchText" BindOnInput="true" DebounceMilliseconds="0" OnPressEnter="@(async () => await OnSearchAsync())" Placeholder="請輸入搜尋關鍵字" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <Tooltip Title="清空搜尋">
                        <Button Type="ButtonType.Default" OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="close" /><span>清空搜尋</span></span>
                        </Button>
                    </Tooltip>
                }
                <Tooltip Title="搜尋">
                    <Button Type="ButtonType.Default" OnClick="@(async () => await OnSearchAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="search" /><span>搜尋</span></span>
                    </Button>
                </Tooltip>
            </div>
        </div>
        <div class="meeting-view-table-wrap">
            <Table @ref="table"
                   TItem="MeetingAdapterModel"
                   Class="meeting-view-table"
                   RemoteDataSource="true"
                   DataSource="@meetingAdapterModels"
                   OnChange="OnTableChange"
                   @bind-PageIndex="_pageIndex"
                   @bind-PageSize="_pageSize"
                   @bind-Total="_total">
                @* 所屬專案併在標題底下當第二行，不另開一欄——操作欄最多會有 11 顆圖示，能省一欄是一欄。 *@
                <Column TData="string" DataIndex="@nameof(MeetingAdapterModel.Title)" Title="會議標題" Sortable>
                    <div class="meeting-title-cell">
                        <span class="meeting-title-name">@context.Title</span>
                        <span class="@(context.IsUnassigned ? "meeting-title-project meeting-title-project-unassigned" : "meeting-title-project")"
                              title="@context.ProjectTitleText">@context.ProjectTitleText</span>
                    </div>
                </Column>
                <Column TData="DateTime?" DataIndex="@nameof(MeetingAdapterModel.MeetingDate)" Title="會議日期" Format="yyyy/MM/dd" Sortable />
                <Column TData="string" Title="影音檔">
                    @if (context.HasMedia)
                    {
                        <div class="meeting-media-cell">
                            <span class="meeting-media-name" title="@context.MediaOriginalFileName">@context.MediaOriginalFileName</span>
                            <span class="meeting-media-size">@MeetingMediaPolicy.FormatFileSize(context.MediaFileSize ?? 0)</span>
                        </div>
                    }
                    else
                    {
                        <span class="meeting-media-empty">尚未上傳</span>
                    }
                </Column>
                <Column TData="TranscriptionStatus" DataIndex="@nameof(MeetingAdapterModel.TranscriptionStatus)" Title="轉錄狀態" Sortable>
                    <span class="meeting-status @GetStatusCssClass(context.TranscriptionStatus)">@context.TranscriptionStatusText</span>
                    @{
                        var progress = GetLiveProgress(context.Id);
                    }
                    @if (progress is not null)
                    {
                        <Tooltip Title="@DescribeProgressPhase(progress)">
                            <span class="meeting-status-percent">@progress.Percent%</span>
                        </Tooltip>
                    }
                    @if (context.TranscriptionStatus == TranscriptionStatus.Failed && !string.IsNullOrWhiteSpace(context.TranscriptionError))
                    {
                        <Tooltip Title="@context.TranscriptionError">
                            <span class="meeting-status-error-hint">⚠</span>
                        </Tooltip>
                    }
                </Column>
                @* Sortable="false"：服務層的排序白名單沒有 DraftStatus，掛上去只會得到一顆按了沒反應的箭頭。 *@
                <Column TData="DraftStatus" DataIndex="@nameof(MeetingAdapterModel.DraftStatus)" Title="會議紀錄" Sortable="false">
                    <span class="meeting-status @GetDraftStatusCssClass(context.DraftStatus)">@context.DraftStatusText</span>
                    @{
                        var draftProgress = GetLiveDraftProgress(context.Id);
                    }
                    @if (draftProgress is not null)
                    {
                        <span class="meeting-status-percent">@draftProgress.Percent%</span>
                    }
                    @if (context.DraftStatus == DraftStatus.Failed && !string.IsNullOrWhiteSpace(context.DraftError))
                    {
                        <Tooltip Title="@context.DraftError">
                            <span class="meeting-status-error-hint">⚠</span>
                        </Tooltip>
                    }
                </Column>
                <Column TData="DateTime" DataIndex="@nameof(MeetingAdapterModel.UpdatedAt)" Title="更新時間" Sortable DefaultSortOrder="SortDirection.Descending" />
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                    <Space>
                        @if (context.HasDraft)
                        {
                            <SpaceItem>
                                <CrudActionButton Title="檢視會議紀錄" Icon="visibility"
                                                  OnClick="@(async () => await OnViewDraftAsync(context))" />
                            </SpaceItem>
                        }
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_會議紀錄, PermissionActions.Edit))
                        {
                            @if (context.CanGenerateDraft)
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="AI 轉會議紀錄" Icon="auto_awesome"
                                                      OnClick="@(async () => await OnOpenDraftRequestAsync(context))" />
                                </SpaceItem>
                            }
                            @* ⚠️ 只有**未歸屬專案**的會議能在這裡編修（0.4.82）。
                               已歸屬的會議，編修與匯出都集中在專案項目頁——那裡才有專案脈絡
                               （常用名詞、與會人員），而且 PDF 表頭要帶專案名稱。
                               已歸屬的使用者在這裡按「檢視」會看到視窗底部的指路說明，
                               不會以為功能不見了。 *@
                            @if (context.HasDraft && context.IsUnassigned)
                            {
                                @* 用 edit_note 而不是 edit，免得跟底下那顆「修改」撞圖示。 *@
                                <SpaceItem>
                                    <CrudActionButton Title="編修會議紀錄" Icon="edit_note"
                                                      OnClick="@(async () => await OnEditDraftAsync(context))" />
                                </SpaceItem>
                            }
                        }
                        @* 匯出 PDF 的按鈕 0.4.82 起不放在列上：未歸屬的在編修視窗裡按，
                           已歸屬的到專案項目頁按（那裡的 PDF 會帶專案名稱，這裡的不會）。 *@
                        @* 問答的脈絡來自會議紀錄與逐字稿，兩者都沒有時開了也只會得到空脈絡。 *@
                        @if (context.HasDraft || context.HasTranscript)
                        {
                            <SpaceItem>
                                <CrudActionButton Title="AI 問答" Icon="forum"
                                                  OnClick="@(() => OpenMeetingChat(context))" />
                            </SpaceItem>
                        }
                        @* 「抽出待辦」0.4.83 起只留在專案項目頁。待辦在資料表層級就必須有專案，
                           這一頁有一半的會議是未歸屬的，按了也只能跳訊息叫使用者先去歸屬——
                           那不是功能，是一顆騙人的按鈕。歸屬過的會議本來就會出現在專案頁的清單裡。 *@
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_會議紀錄, PermissionActions.Edit))
                        {
                            @* 歸屬不是破壞性動作，不掛 Danger；紅色留給專案頁那顆「從專案移除」。 *@
                            @if (context.IsUnassigned)
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="歸屬到專案" Icon="link"
                                                      OnClick="@(async () => await OnOpenAttachAsync(context))" />
                                </SpaceItem>
                            }
                            @if (context.CanRetryTranscription)
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="重新轉錄" Icon="autorenew"
                                              Disabled="@(requeueingMeetingId is not null)"
                                                      OnClick="@(async () => await OnRetryTranscriptionAsync(context))" />
                                </SpaceItem>
                            }
                            <SpaceItem>
                                <CrudActionButton Title="修改" Icon="edit"
                                                  OnClick="@(async () => await OnEditAsync(context))" />
                            </SpaceItem>
                        }
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_會議紀錄, PermissionActions.Delete))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="刪除" Icon="delete" Danger
                                                  OnClick="@(async () => await OnDeleteAsync(context))" />
                            </SpaceItem>
                        }
                    </Space>
                </ActionColumn>
            </Table>
        </div>
    </div>

    <Modal Title="@modalTitle"
           Class="meeting-view-modal"
           @bind-Visible="@modalVisible"
           Keyboard="true"
           ConfirmLoading="@isUploading"
           MaskClosable="false"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <div>
            <EditForm Model="@CurrentRecord" Context="editContext" @onkeydown="OnModalKeyDownAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputWatcher EditContextActionChanged="OnEditContestChanged" />

                <AntDesign.Form TModel="MeetingAdapterModel" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                    <div class="form-modal-grid">
                        <FormItem Label="會議標題" Required>
                            <Input @bind-Value="CurrentRecord.Title" Placeholder="請輸入會議標題" />
                            <ValidationMessage For="() => CurrentRecord.Title" />
                        </FormItem>

                        <FormItem Label="會議日期">
                            <DatePicker TValue="DateTime?" @bind-Value="CurrentRecord.MeetingDate" AllowClear="true" Style="width: 100%;" />
                            <ValidationMessage For="() => CurrentRecord.MeetingDate" />
                        </FormItem>

                        <FormItem Label="描述" Class="form-modal-full">
                            <TextArea @bind-Value="CurrentRecord.Description" Rows="3" Placeholder="請輸入會議說明" />
                            <ValidationMessage For="() => CurrentRecord.Description" />
                        </FormItem>

                        <FormItem Label="影音檔" Class="form-modal-full">
                            @* accept 只擋檔案挑選對話框，拖進來的檔案仍要靠 OnMediaFileSelectedAsync
                               裡的 MeetingMediaPolicy.IsAllowedFileName 把關（那一段本來就在）。 *@
                            <FileDropZone @ref="mediaDropZone"
                                          OnChange="OnMediaFileSelectedAsync"
                                          Accept="@MeetingMediaPolicy.AcceptAttribute"
                                          Disabled="@isUploading"
                                          Title="把影音檔拖到這裡，或點擊選擇檔案（一次一個）">
                                @* 「一次一個」要寫出來：單檔模式下一次拖入多個檔案，Chrome 會整個靜默拒絕——
                                   不觸發 change、不報錯，使用者只會覺得「拖進去沒反應」。 *@
                                單檔上限 @MeetingMediaPolicy.FormatFileSize(MeetingMediaPolicy.MaxUploadFileSize)，支援格式：@MeetingMediaPolicy.AllowedExtensionsText。
                                儲存後會自動排入背景轉錄，影片只會取用聲音軌。
                            </FileDropZone>

                            @if (pendingMediaFile is not null)
                            {
                                <div class="meeting-view-pending-file">
                                    待上傳：@pendingMediaFile.Name（@MeetingMediaPolicy.FormatFileSize(pendingMediaFile.Size)）
                                    @if (!isUploading)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="ClearPendingMediaFile">移除</button>
                                    }
                                </div>
                            }
                            else if (CurrentRecord.HasMedia)
                            {
                                <div class="meeting-view-pending-file">
                                    目前檔案：@CurrentRecord.MediaOriginalFileName（@MeetingMediaPolicy.FormatFileSize(CurrentRecord.MediaFileSize ?? 0)）
                                    <span class="meeting-view-upload-hint">選擇新檔案會取代現有檔案與逐字稿。</span>
                                </div>
                            }

                            @if (isUploading || uploadPercent > 0)
                            {
                                <Progress Percent="uploadPercent" Status="@(isUploading ? ProgressStatus.Active : ProgressStatus.Success)" />
                            }
                        </FormItem>
                    </div>
                </AntDesign.Form>
            </EditForm>
        </div>
    </Modal>

    <Modal Title="AI 轉會議紀錄"
           Class="form-modal-compact"
           @bind-Visible="@draftRequestVisible"
           Keyboard="true"
           MaskClosable="false"
           OkText="@("開始產生")"
           CancelText="@("取消")"
           ConfirmLoading="@isGenerating"
           OnOk="OnDraftRequestOkAsync"
           OnCancel="OnDraftRequestCancelAsync">
        @* 這裡不用 AntDesign.Form／FormItem：那組元件需要一個 TModel，而這個對話框沒有對應的
           資料模型，硬造一個假的只為了排版並不划算。欄位全部整列，本來也用不到兩欄格線。
           keydown 掛在這層原生 div：AntDesign Modal 沒有開放掛載點（Keyboard 只管 Esc）。 *@
        <div class="meeting-draft-request-form" @onkeydown="OnDraftRequestKeyDownAsync">
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">來源逐字稿</span>
                <span class="meeting-draft-request-source">@draftRequestMeetingTitle</span>
            </div>
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">提示詞</span>
                <Select TItem="PromptTemplateAdapterModel"
                        TItemValue="int"
                        @key="@($"prompt-{draftRequestOpenCount}")"
                        DataSource="@promptTemplates"
                        @bind-Value="draftRequestPromptTemplateId"
                        LabelName="@nameof(PromptTemplateAdapterModel.Name)"
                        ValueName="@nameof(PromptTemplateAdapterModel.Id)"
                        EnableSearch
                        Placeholder="選擇要套用的提示詞"
                        Style="width: 100%;" />
            </div>
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">所屬專案（選填）</span>
                <Select TItem="ProjectAdapterModel"
                        TItemValue="int"
                        @key="@($"project-{draftRequestOpenCount}")"
                        DataSource="@projects"
                        @bind-Value="draftRequestProjectId"
                        @bind-Value:after="OnDraftRequestProjectChanged"
                        LabelName="@nameof(ProjectAdapterModel.Title)"
                        ValueName="@nameof(ProjectAdapterModel.Id)"
                        EnableSearch
                        AllowClear
                        Disabled="@draftRequestLockedProject"
                        Placeholder="不指定專案（之後可再歸屬）"
                        Style="width: 100%;" />
            </div>
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">與會人員</span>
                @* @key 同時綁開啟次數與專案 Id：前者讓「關掉再對另一筆開啟」重建元件
                   （用資料 Id 當 key 沒有用，同一筆重開 Id 不變），後者處理對話框開著時換專案。 *@
                <Select TItem="string"
                        TItemValue="string"
                        Mode="SelectMode.Multiple"
                        @key="@($"attendees-{draftRequestOpenCount}-{draftRequestProjectId}")"
                        Values="draftRequestAttendees"
                        OnSelectedItemsChanged="OnDraftRequestAttendeesChanged"
                        Disabled="@(draftRequestProjectId <= 0 || DraftRequestParticipants.Count == 0)"
                        Placeholder="@DraftRequestAttendeePlaceholder"
                        MaxTagCount="3"
                        AllowClear EnableSearch
                        Style="width: 100%;">
                    @foreach (var person in DraftRequestParticipants)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@person">@person</SelectOption>
                    }
                </Select>
            </div>
        </div>
        <p class="meeting-draft-request-note">
            @if (draftRequestLockedProject)
            {
                <span>這份逐字稿已經歸屬專案，重新產生不會變更歸屬。</span>
            }
            else
            {
                <span>不指定專案也可以產生會議紀錄，但不會套用專案的常用名詞校正；之後可以用「歸屬到專案」補上。</span>
            }
        </p>
    </Modal>

    <Modal Title="歸屬到專案"
           Class="form-modal-compact"
           @bind-Visible="@attachVisible"
           Keyboard="true"
           MaskClosable="false"
           OkText="@("歸屬")"
           CancelText="@("取消")"
           ConfirmLoading="@isAttaching"
           OnOk="OnAttachOkAsync"
           OnCancel="OnAttachCancelAsync">
        <div class="meeting-draft-request-form" @onkeydown="OnAttachKeyDownAsync">
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">會議紀錄</span>
                <span class="meeting-draft-request-source">@attachMeetingTitle</span>
            </div>
            <div class="meeting-draft-request-field">
                <span class="meeting-draft-request-label">歸屬到</span>
                <Select TItem="ProjectAdapterModel"
                        TItemValue="int"
                        @key="@($"attach-{attachOpenCount}")"
                        DataSource="@projects"
                        @bind-Value="attachProjectId"
                        LabelName="@nameof(ProjectAdapterModel.Title)"
                        ValueName="@nameof(ProjectAdapterModel.Id)"
                        EnableSearch
                        Placeholder="選擇專案"
                        Style="width: 100%;" />
            </div>
        </div>
        <p class="meeting-draft-request-note">
            只變更歸屬，不會重新產生會議紀錄，也不會產生任何費用。歸屬後即可抽出待辦事項。
        </p>
    </Modal>

    @* 檢視與編修 0.4.82 起共用同一個視窗，差別只在 CanEdit。
       編修模式是左改右看＋常駐搜尋取代列；唯讀模式只剩右邊的預覽。 *@
    <MarkdownEditorModal @bind-Visible="@draftModalVisible"
                         Title="@draftModalTitle"
                         Content="@draftContent"
                         CanEdit="@draftCanEdit"
                         CanExport="@draftCanExport"
                         IsExporting="@(exportingMeetingId is not null)"
                         IsSaving="@isSavingDraft"
                         Notice="@draftNotice"
                         OnExport="OnExportCurrentDraftAsync"
                         OnSave="OnDraftSavedAsync" />

    @* AiChatModal 放在 Views.Projects 命名空間下。搬到共用目錄比較乾淨，
       但那會動到專案頁；依外科手術原則這裡只加 using。 *@
    <AiChatModal @bind-Visible="aiChatVisible"
                 Scope="AiChatScope.Meeting"
                 TargetId="@aiChatTargetId"
                 Title="@aiChatTitle"
                 TargetName="@aiChatTargetName"
                 CanExport="@AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_會議紀錄, PermissionActions.Export)" />
}
