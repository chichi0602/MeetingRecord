@using MeetingRecord.Business.Helpers

@* 專案層級與單一會議共用同一個問答視窗，差別只在 Scope 與 TargetId。 *@
<Modal Title="@Title"
       Class="form-modal-wide"
       Visible="@Visible"
       Keyboard="true"
       MaskClosable="false"
       Footer="null"
       OnCancel="OnCancelAsync">
  <div class="ai-chat-shell">
    @* 左欄：這個專案／會議底下的所有對話。共用的，所以每一列要看得出是誰開的。 *@
    <aside class="ai-chat-sessions">
        <div class="ai-chat-sessions-head">
            <span class="ai-chat-sessions-title">對話紀錄</span>
            <Tooltip Title="@NewConversationTooltip">
                <Button Type="ButtonType.Default" Size="ButtonSize.Small"
                        Disabled="@(IsBusy || CurrentConversation is { MessageCount: 0 })"
                        OnClick="OnNewConversationAsync">
                    <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>開新對話</span></span>
                </Button>
            </Tooltip>
        </div>

        <div class="ai-chat-sessions-list">
            @foreach (var session in conversations)
            {
                var sessionId = session.Id;

                <div class="ai-chat-session @(string.Equals(sessionId, currentConversationId, StringComparison.Ordinal) ? "ai-chat-session-on" : string.Empty)">
                    @if (string.Equals(renamingId, sessionId, StringComparison.Ordinal))
                    {
                        @* 改名中。Enter 送出、Esc 取消，與全站一致（走 FormKeyboardHelper）。 *@
                        <div class="ai-chat-session-rename" @onkeydown="OnRenameKeyDownAsync">
                            <Input @bind-Value="renamingText" BindOnInput="true" DebounceMilliseconds="0" MaxLength="60" />
                            <div class="ai-chat-session-rename-actions">
                                <Button Type="ButtonType.Link" Size="ButtonSize.Small" OnClick="OnRenameCommitAsync">儲存</Button>
                                <Button Type="ButtonType.Link" Size="ButtonSize.Small" OnClick="OnRenameCancel">取消</Button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="ai-chat-session-main"
                                disabled="@IsBusy"
                                @onclick="@(async () => await OnSelectConversationAsync(sessionId))">
                            <span class="ai-chat-session-name" title="@session.Title">@session.Title</span>
                            <span class="ai-chat-session-meta">
                                @session.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
                                @if (!string.IsNullOrWhiteSpace(session.CreatedBy))
                                {
                                    <span> · @session.CreatedBy</span>
                                }
                            </span>
                        </button>

                        <div class="ai-chat-session-tools">
                            <CrudActionButton Title="重新命名" Icon="edit"
                                              Disabled="@IsBusy"
                                              OnClick="@(() => OnRenameStart(session))" />
                            <CrudActionButton Title="刪除這段對話" Icon="delete" Danger="true"
                                              Disabled="@IsBusy"
                                              OnClick="@(async () => await OnDeleteConversationAsync(session))" />
                        </div>
                    }
                </div>
            }
        </div>
    </aside>

    <div class="ai-chat">
        @if (!string.IsNullOrWhiteSpace(sourceNotice))
        {
            <div class="ai-chat-notice">
                <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="info" />
                <span>@sourceNotice</span>
            </div>
        }

        <div class="ai-chat-log">
            @if (messages.Count == 0 && !isAsking)
            {
                <div class="ai-chat-empty">
                    還沒有任何問答。試著問問看「這個會議做了哪些決議？」或「合約的付款條件是什麼？」
                </div>
            }

            @* 用索引而不是 foreach：每一則的複製／編輯／下載都要知道自己是第幾則。
               ⚠️ for 的迴圈變數不會逐次捕獲，閉包一定要先複製一份到區域變數。 *@
            @for (var loopIndex = 0; loopIndex < messages.Count; loopIndex++)
            {
                var index = loopIndex;
                var message = messages[index];

                <div class="ai-chat-row @(message.IsUser ? "ai-chat-row-user" : "ai-chat-row-assistant")">
                    <div class="ai-chat-meta">
                        @(message.IsUser ? (message.AskedBy ?? "使用者") : "AI 助理")
                        <span class="ai-chat-time">@message.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>

                        @* 刻意不是「hover 才出現」：純 hover 的按鈕觸控裝置點不到、鍵盤也 tab 不進去。
                           平時降低不透明度，滑過或取得焦點時才完全顯現。 *@
                        <span class="ai-chat-tools">
                            <CrudActionButton Title="複製內容"
                                              Icon="content_copy"
                                              Disabled="@IsBusy"
                                              OnClick="@(() => OnCopyAsync(index))" />
                            <CrudActionButton Title="編輯"
                                              Icon="edit"
                                              Disabled="@IsBusy"
                                              OnClick="@(() => OnStartEdit(index))" />
                            @if (CanExport)
                            {
                                <CrudActionButton Title="下載這則 PDF"
                                                  Icon="picture_as_pdf"
                                                  Disabled="@IsBusy"
                                                  OnClick="@(() => OnDownloadMessageAsync(index))" />
                            }
                        </span>
                    </div>

                    @if (editingIndex == index)
                    {
                        <div class="ai-chat-edit">
                            <TextArea @bind-Value="editingText"
                                      BindOnInput="true"
                                      DebounceMilliseconds="0"
                                      Rows="6"
                                      Disabled="@IsBusy" />
                            <div class="ai-chat-edit-actions">
                                @* 儲存只改文字、不呼叫模型，所以不需要費用確認。 *@
                                <Button Type="ButtonType.Primary"
                                        Loading="@isSavingEdit"
                                        Disabled="@(IsBusy || string.IsNullOrWhiteSpace(editingText))"
                                        OnClick="OnSaveEditAsync">
                                    儲存
                                </Button>

                                @if (message.IsUser)
                                {
                                    @* 重新產生會呼叫模型，OnRegenerateAsync 裡一定會先跳費用確認（§6.3）。 *@
                                    <Button Loading="@isRegenerating"
                                            Disabled="@(IsBusy || string.IsNullOrWhiteSpace(editingText))"
                                            OnClick="OnRegenerateAsync">
                                        重新產生答案
                                    </Button>
                                }

                                <Button Type="ButtonType.Link" Disabled="@IsBusy" OnClick="OnCancelEdit">取消</Button>
                            </div>
                            @if (message.IsUser)
                            {
                                <div class="ai-chat-edit-hint">
                                    「儲存」只更正文字，不會重跑 AI；「重新產生答案」會重新呼叫 Azure OpenAI 並覆蓋下方的回答。
                                </div>
                            }
                        </div>
                    }
                    else if (message.IsUser)
                    {
                        @* 提問是使用者自己打的純文字，維持 pre-wrap 保留斷行。 *@
                        <div class="ai-chat-bubble ai-chat-bubble-plain">@message.Content</div>
                    }
                    else
                    {
                        @* 回答是 Markdown，渲染成 HTML 才不會看到滿畫面的 ## 與 **。
                           內容已由 MarkdownRenderer 擋掉原始 HTML 與危險的連結通訊協定。 *@
                        <div class="ai-chat-bubble ai-chat-bubble-markdown">
                            @((MarkupString)MarkdownRenderer.ToHtml(message.Content))
                        </div>
                    }
                </div>
            }

            @if (isAsking || isRegenerating)
            {
                <div class="ai-chat-row ai-chat-row-assistant">
                    <div class="ai-chat-meta">AI 助理</div>
                    @* 串流中維持純文字：逐個 token 跑一次 Markdig 既浪費，
                       半截的語法還會讓畫面一直閃。答完重載歷史時才換成渲染版。 *@
                    <div class="ai-chat-bubble ai-chat-bubble-plain">
                        @if (streamingAnswer.Length == 0)
                        {
                            <span class="ai-chat-thinking">正在讀取資料…</span>
                        }
                        else
                        {
                            @streamingAnswer
                        }
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="ai-chat-error" role="alert">@errorMessage</div>
        }

        @* 問答刻意不做二次確認：一次一個問題、防連點已完整（isAsking ＋ Loading ＋ Disabled），
           每句都跳確認會讓功能不能用。改成常駐提示，放在輸入框旁邊——錢是在這裡花的。 *@
        <div class="ai-chat-cost-hint">
            <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="info" />
            <span>每次送出都會呼叫 Azure OpenAI 並產生費用（一次提問一次呼叫）。</span>
        </div>
        <div class="ai-chat-input">
            @* Enter 送出、Shift+Enter 換行，是聊天介面的通用預期。

               BindOnInput 必須開：AntDesign 的 Input 預設只在 change（失焦）才把值寫回，
               打字期間 question 會一直是空字串，送出鈕就一直停用、要點到輸入框外面才亮。

               DebounceMilliseconds 必須是 0（0.4.52 曾用預設的 250ms，是錯的）：
               打完字立刻按 Enter 時，debounce 計時器還沒觸發，OnAskAsync 讀到的
               question 會是舊值甚至空字串——送出的問題會被截斷，或整個不送出，
               然後計時器才把文字寫回輸入框。代價是逐鍵一次伺服器往返，但正確性優先。 *@
            <TextArea @bind-Value="question"
                      BindOnInput="true"
                      DebounceMilliseconds="0"
                      Placeholder="輸入問題後按 Enter 送出（Shift+Enter 換行）"
                      Rows="2"
                      Disabled="@IsBusy"
                      OnkeyDown="OnKeyDownAsync" />
            <Button Type="ButtonType.Primary"
                    Loading="@isAsking"
                    Disabled="@(IsBusy || string.IsNullOrWhiteSpace(question))"
                    OnClick="OnAskAsync">
                <span class="ai-chat-send">
                    <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="send" />
                    <span>送出</span>
                </span>
            </Button>
        </div>

        @if (messages.Count > 0)
        {
            <div class="ai-chat-actions">
                @if (CanExport)
                {
                    <Button Type="ButtonType.Link"
                            Loading="@isDownloadingConversation"
                            Disabled="@IsBusy"
                            OnClick="OnDownloadConversationAsync">
                        下載整段對話 PDF
                    </Button>
                }
                <Button Type="ButtonType.Link" Disabled="@IsBusy" OnClick="OnClearAsync">清空這段對話</Button>
            </div>
        }
    </div>
  </div>
</Modal>
