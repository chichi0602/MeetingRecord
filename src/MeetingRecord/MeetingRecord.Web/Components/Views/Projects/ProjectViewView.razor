@using MeetingRecord.Share.Helpers
@using MeetingRecord.Business.Services.DataAccess
@using MeetingRecord.Share.Enums
@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        @* 工具列一行（0.4.106）：左邊選專案與操作，右邊篩選。窄螢幕允許換行。 *@
        <div class="project-view-picker">
          <div class="project-view-picker-left">
            <span class="project-view-field-label">專案</span>
            <Select TItem="ProjectAdapterModel"
                    TItemValue="int"
                    Value="@selectedProjectId"
                    ValueChanged="OnProjectSelectedAsync"
                    DataSource="@FilteredProjects"
                    LabelName="@nameof(ProjectAdapterModel.SelectorLabel)"
                    ValueName="@nameof(ProjectAdapterModel.Id)"
                    Placeholder="請選擇專案"
                    EnableSearch
                    Class="project-view-project-select" />

            @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Create))
            {
                <HoverTip Title="新增專案">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnAddAsync(true))">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增專案</span></span>
                    </Button>
                </HoverTip>
            }
            @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Edit))
            {
                <HoverTip Title="編輯專案">
                    <Button Type="ButtonType.Default"
                            Disabled="@(SelectedProject is null)"
                            OnClick="@(async () => await OnEditSelectedAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="edit" /><span>編輯專案</span></span>
                    </Button>
                </HoverTip>
            }
            @* 1.0.52：刪除專案只限負責人；負責人是一般使用者（沒有刪除權限）也能刪，所以這裡看「編輯」，按鈕本身再看是不是負責人。 *@
            @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Edit))
            {
                <HoverTip Title="刪除專案">
                    <Button Type="ButtonType.Default" Class="project-view-icon-button-danger"
                            Disabled="@(!CanDeleteSelectedProject)"
                            OnClick="@(async () => await OnDeleteSelectedAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="delete" /><span>刪除專案</span></span>
                    </Button>
                </HoverTip>
            }
            @* 刻意放在工具列而不是下方的 AI 生成區塊——那一整塊需要 Edit 權限，
               而問答是唯讀操作，有頁面權限就該能用。 *@
            <HoverTip Title="就整個專案的會議紀錄與附件提問">
                <Button Type="ButtonType.Default"
                        Disabled="@(SelectedProject is null)"
                        OnClick="OpenProjectChat">
                    <span class="project-view-cta">
                        <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="forum" />
                        <span class="project-view-cta-text">AI 問答</span>
                    </span>
                </Button>
            </HoverTip>
            @* 1.0.54：唯讀動作，比照 AI 問答只要頁面權限；已完成（封存）的專案也能匯出。 *@
            <HoverTip Title="把這個專案的所有待辦匯出成 PDF，看進度">
                <Button Type="ButtonType.Default"
                        Disabled="@(SelectedProject is null)"
                        Loading="@isExportingTodos"
                        OnClick="OnExportTodosAsync">
                    <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="picture_as_pdf" /><span>待辦 PDF</span></span>
                </Button>
            </HoverTip>
          </div>

          @* 篩選只縮小上面的專案下拉，不影響誰看得到。MaxTagCount=1：多選時收成「+N」，寬度固定不撐開。 *@
          <div class="project-view-picker-right">
            @* 1.0.46：已完成＝封存。預設只看使用中，每次開頁都回到使用中。 *@
            <ProjectScopeSwitch Value="@projectScope" ValueChanged="OnProjectScopeChangedAsync" />
            <Select TItem="int" TItemValue="int" Mode="SelectMode.Multiple"
                    Values="teamFilters" OnSelectedItemsChanged="OnTeamFiltersChanged"
                    Placeholder="團隊" MaxTagCount="1"
                    AllowClear EnableSearch
                    Style="width: 140px;">
                @foreach (var t in filterTeamOptions)
                {
                    <SelectOption TItemValue="int" TItem="int" Value="@t.Id" Label="@t.Name" />
                }
            </Select>
            <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                    Values="categoryFilters" OnSelectedItemsChanged="OnCategoryFiltersChanged"
                    Placeholder="分類" MaxTagCount="1"
                    AllowClear EnableSearch
                    Style="width: 140px;">
                @foreach (var c in availableCategories)
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@c">@c</SelectOption>
                }
            </Select>
            <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                    Values="statusFilters" OnSelectedItemsChanged="OnStatusFiltersChanged"
                    Placeholder="狀態" MaxTagCount="1"
                    AllowClear
                    Style="width: 140px;">
                @foreach (var s in ScopeStatusOptions)
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@s">@s</SelectOption>
                }
            </Select>
          </div>
        </div>

        @if (SelectedProject is null)
        {
            <div class="project-view-empty">
                @(projects.Count == 0 ? "目前沒有可存取的專案，請先新增一個專案。" : "請先從上方選擇一個專案。")
            </div>
        }
        else
        {
            @if (SelectedProject.IsArchived)
            {
                @* 1.0.46：已完成＝封存，一般使用者唯讀（管理者不受限，但提示照樣顯示）。 *@
                <div class="project-view-archived">
                    <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="inventory_2" />
                    <span>這個專案已完成（封存）@(IsReadOnlyProject ? "，目前是唯讀：可以檢視、下載 PDF、AI 問答，不能產生會議紀錄、抽出待辦或移除會議。" : "。你是管理者，仍可修改。")</span>
                    @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Edit))
                    {
                        <Button Size="ButtonSize.Small" Loading="@isReopening" OnClick="OnReopenAsync">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="unarchive" /><span>重新開啟</span></span>
                        </Button>
                    }
                </div>
            }

            <div class="project-view-summary">
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">負責人</span>
                    <span class="project-view-summary-value">
                        @DescribeOwner(SelectedProject)
                    </span>
                </div>
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">主責團隊</span>
                    <span class="project-view-summary-value">
                        @(string.IsNullOrEmpty(SelectedProject.PrimaryTeamName) ? "—" : SelectedProject.PrimaryTeamName)
                    </span>
                </div>
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">協作團隊</span>
                    <span class="project-view-summary-value">
                        @(SelectedProject.CollaboratorTeamNames.Count == 0 ? "—" : string.Join("、", SelectedProject.CollaboratorTeamNames))
                    </span>
                </div>
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">分類</span>
                    <span class="project-view-summary-value">
                        @(SelectedProject.Categories.Count == 0 ? "—" : string.Join("、", SelectedProject.Categories))
                    </span>
                </div>
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">期程</span>
                    <span class="project-view-summary-value">@FormatDateRange(SelectedProject.StartDate, SelectedProject.EndDate)</span>
                </div>
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">狀態</span>
                    <span class="project-view-summary-value">@SelectedProject.Status</span>
                </div>
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">完成度</span>
                    <span class="project-view-summary-value">
                        <Progress Type="ProgressType.Line" Percent="@SelectedProject.CompletionPercentage" Size="ProgressSize.Small" />
                    </span>
                </div>
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">會議紀錄</span>
                    <span class="project-view-summary-value">@projectMeetings.Count 份</span>
                </div>
                <div class="project-view-summary-item">
                    <span class="project-view-summary-key">附件</span>
                    <span class="project-view-summary-value">
                        @* 0 份不做成可點的——點開空清單沒有意義。 *@
                        @if (projectFiles.Count > 0)
                        {
                            <button type="button" class="project-view-summary-link" @onclick="OpenAttachmentModal">
                                @projectFiles.Count 份
                            </button>
                        }
                        else
                        {
                            <span>0 份</span>
                        }
                    </span>
                </div>
            </div>

            @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Edit) && !IsReadOnlyProject)
            {
                @* tabindex＋@ref：會議紀錄視窗按「產生會議紀錄」時聚焦這裡，讓瀏覽器把區塊捲進畫面（1.0.48）。 *@
                <div class="project-view-ai-panel" tabindex="-1" @ref="aiPanelElement">
                    <div class="project-view-ai-head">
                        <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="auto_awesome" />
                        <h3>用 AI 把逐字稿整理成會議紀錄</h3>
                    </div>

                    <div class="project-view-ai-controls">
                        <div class="project-view-ai-field project-view-ai-field-grow">
                            <span class="project-view-field-label">選擇逐字稿</span>
                            <Select TItem="MeetingAdapterModel"
                                    TItemValue="int"
                                    @bind-Value="selectedTranscriptId"
                                    DataSource="@selectableTranscripts"
                                    LabelName="@nameof(MeetingAdapterModel.Title)"
                                    ValueName="@nameof(MeetingAdapterModel.Id)"
                                    ItemDisabled="IsTranscriptDisabled"
                                    Placeholder="請選擇逐字稿"
                                    EnableSearch
                                    Style="width: 100%;">
                                <ItemTemplate Context="transcript">
                                    <div class="project-view-dd-item">
                                        <span class="project-view-dd-name">@transcript.Title</span>
                                        <span class="project-view-dd-meta">@DescribeTranscriptOwnership(transcript)</span>
                                    </div>
                                </ItemTemplate>
                            </Select>
                            <span class="project-view-hint">
                                共 @selectableTranscripts.Count 份逐字稿，@selectableTranscripts.Count(x => x.IsUnassigned) 份未歸屬；已被其他專案取用的無法選取。
                            </span>
                        </div>

                        @* 本次實到者：從專案名冊挑，不是 Tags 模式——這裡只准選名冊裡有的人。
                           ⚠️ @key 綁專案：切換專案時外部把選取清空，但 SelectBase 在「新專案沒有選項」
                           的情況下會直接 return，舊的標籤會留在畫面上。 *@
                        <div class="project-view-ai-field">
                            <span class="project-view-field-label">與會人員</span>
                            <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                    @key="@($"attendees-{selectedProjectId}")"
                                    Values="selectedAttendees"
                                    OnSelectedItemsChanged="OnSelectedAttendeesChanged"
                                    Disabled="@(AvailableParticipants.Count == 0)"
                                    Placeholder="@AttendeePlaceholder"
                                    MaxTagCount="2"
                                    AllowClear EnableSearch
                                    Style="min-width: 190px;">
                                @foreach (var person in AvailableParticipants)
                                {
                                    <SelectOption TItemValue="string" TItem="string" Value="@person">@person</SelectOption>
                                }
                            </Select>
                            @if (AvailableParticipants.Count == 0)
                            {
                                <span class="project-view-hint">可在「修改專案」中設定名冊。</span>
                            }
                        </div>

                        <div class="project-view-ai-field">
                            <span class="project-view-field-label">提示詞</span>
                            @* 0.4.114：改用 SelectOption 子元素。DataSource 在每次換專案時重新指派，
                               和主責欄一樣可能出現「畫面空白但帶著值」。 *@
                            <Select TItem="int" TItemValue="int"
                                    @bind-Value="selectedPromptTemplateId"
                                    Placeholder="請選擇提示詞"
                                    EnableSearch
                                    Style="min-width: 190px;">
                                @foreach (var template in promptTemplates)
                                {
                                    <SelectOption TItemValue="int" TItem="int" Value="@template.Id" Label="@template.Name" />
                                }
                            </Select>
                        </div>

                        @* 按鈕包在與兩個下拉相同的欄位堆疊裡，上面墊一個佔位標籤。
                           這樣頂緣由同一組 font-size 與 gap 決定，不必用魔術 margin 去湊。 *@
                        <div class="project-view-ai-field">
                            <span class="project-view-field-label" aria-hidden="true">&nbsp;</span>
                            <Button Type="ButtonType.Primary"
                                    Loading="@isGenerating"
                                    Disabled="@(!CanSubmitDraft)"
                                    OnClick="@(async () => await OnGenerateDraftAsync())">
                                @* 內容包一層自己的 span：CSS isolation 的 scope 屬性只會加在本檔寫的
                                   HTML 元素上，掛在 <Button> 元件的 Class 是選不到的。 *@
                                <span class="project-view-cta">
                                    <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="auto_awesome" />
                                    <span class="project-view-cta-text">AI 轉會議紀錄</span>
                                </span>
                            </Button>
                        </div>
                    </div>

                    <div class="project-view-ai-note">
                        <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="info" />
                        <span>一份逐字稿只能歸屬一個專案。若這份逐字稿已產生過會議紀錄，重新產生會覆蓋舊的內容。</span>
                    </div>
                </div>
            }

            <h3 class="project-view-section-title">
                歷史會議紀錄
                <span class="project-view-section-count">本專案共 @projectMeetings.Count 份</span>
            </h3>

            <BatchSelectionBar Count="@selectedMeetings.Count()" Busy="@isBatchDetaching"
                               ActionText="從專案移除所選" Icon="link_off"
                               OnAction="OnBatchDetachAsync" OnClear="@(() => selectedMeetings = [])" />
            <div class="project-view-table-wrap">
                <Table TItem="MeetingAdapterModel"
                       Class="project-view-table"
                       DataSource="@projectMeetings"
                       RowKey="x => x.Id"
                       @bind-SelectedRows="selectedMeetings"
                       HidePagination="true">
                    @* 多選「從專案移除」（1.0.53）：只有上傳者勾得起來（同單筆 CanDetach）；清單不分頁，全選＝整個清單。 *@
                    @if (projectMeetings.Any(CanDetach))
                    {
                        <Selection Disabled="@(!CanDetach(context))" />
                    }
                    <Column TData="string" Title="來源逐字稿">
                        <span class="project-view-cell-strong">@context.Title</span>
                    </Column>
                    <Column TData="string" Title="使用提示詞">
                        @(context.DraftPromptTemplateName ?? "—")
                    </Column>
                    <Column TData="string" Title="狀態">
                        <span class="project-view-status @DraftStatusCssClass(context.DraftStatus)">@context.DraftStatusText</span>
                        @{
                            var draftProgress = GetLiveDraftProgress(context.Id);
                        }
                        @if (draftProgress is not null)
                        {
                            <HoverTip Title="@DescribeDraftPhase(draftProgress)">
                                <span class="project-view-status-percent">@draftProgress.Percent%</span>
                            </HoverTip>
                        }
                        @if (context.DraftStatus == DraftStatus.Failed && !string.IsNullOrWhiteSpace(context.DraftError))
                        {
                            <HoverTip Title="@context.DraftError">
                                <span class="project-view-error-hint">
                                    <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="error_outline" />
                                </span>
                            </HoverTip>
                        }
                    </Column>
                    <Column TData="DateTime?" Title="產生時間">
                        @(context.DraftCompletedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")
                    </Column>
                    <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                        <Space>
                            @* 1.0.40 起檢視與編修合併成這一顆，逐字稿也在同一個視窗裡（操作欄要簡單）。 *@
                            @if (context.HasDraft || context.HasTranscript)
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="會議紀錄與逐字稿" Icon="article"
                                                      OnClick="@(async () => await OnOpenDraftModalAsync(context))" />
                                </SpaceItem>
                            }
                            @if (context.HasDraft && AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Export))
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="@(exportingMeetingId == context.Id ? "匯出中…" : "匯出 PDF")" Icon="download"
                                                      Disabled="@(exportingMeetingId is not null)"
                                                      OnClick="@(async () => await OnExportDraftAsync(context))" />
                                </SpaceItem>
                            }
                            @* 這顆鈕真正做的事是「新增待辦」，所以權限鍵是待辦事項而不是專案項目。
                               HasDraft 與同列的「檢視會議紀錄」一致——沒有草稿就沒有東西可抽。 *@
                            @if (context.HasDraft
                                 && AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Create)
                                 && !IsReadOnlyProject)
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="抽出待辦" Icon="playlist_add"
                                                      OnClick="@(async () => await OpenTodoExtractionAsync(context))" />
                                </SpaceItem>
                            }
                            @* 不加動作權限檢查，與同列的「檢視會議紀錄」一致（只有編修要 Edit、匯出要 Export）。 *@
                            <SpaceItem>
                                <CrudActionButton Title="AI 問答" Icon="forum"
                                                  OnClick="@(() => OpenMeetingChat(context))" />
                            </SpaceItem>
                            @* 生成錯專案的出口。刻意是「移除歸屬」而不是刪除：影音檔與逐字稿留著，
                               那份逐字稿會回到可選清單，指定到正確的專案重跑即可——不必重新上傳、
                               也不會再付一次轉錄費用。真正的整筆刪除仍然只在「會議紀錄」頁。 *@
                            @if (CanDetach(context))
                            {
                                <SpaceItem>
                                    <CrudActionButton Title="從專案移除" Icon="link_off" Danger="true"
                                                      Disabled="@(detachingMeetingId is not null)"
                                                      OnClick="@(async () => await OnDetachMeetingAsync(context))" />
                                </SpaceItem>
                            }
                        </Space>
                    </ActionColumn>
                </Table>
            </div>
        }
    </div>

    <Modal Title="@modalTitle"
           Class="form-modal-large"
           @bind-Visible="@modalVisible"
           Keyboard="true"
           ConfirmLoading="@(isSaving || isReadingFiles)"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <div>
            <EditForm Model="@CurrentRecord" Context="editContext" @onkeydown="OnModalKeyDownAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputWatcher EditContextActionChanged="OnEditContestChanged" />

                <AntDesign.Form TModel="ProjectAdapterModel" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                    <div class="form-modal-grid">
                        <FormItem Label="標題" Required>
                            <Input @bind-Value="CurrentRecord.Title" Placeholder="請輸入專案標題" />
                            <ValidationMessage For="() => CurrentRecord.Title" />
                        </FormItem>

                        @* 1.0.52：負責人從主責＋協作團隊裡啟用中的帳號選，可打姓名或帳號搜尋；團隊一改候選人就跟著變。
                           負責人（與管理者）可以刪除專案與底下任何人的會議、待辦、附件。 *@
                        <FormItem Label="負責人" Required>
                            <div @onkeydown:stopPropagation="true">
                                <Select TItem="int?" TItemValue="int?"
                                        @bind-Value="CurrentRecord.OwnerUserId"
                                        Disabled="@(!CanChangeOwner)"
                                        Placeholder="@(ownerCandidates.Count == 0 ? "請先選擇主責團隊" : "請選擇負責人（可輸入姓名或帳號搜尋）")"
                                        AllowClear EnableSearch Style="width: 100%;">
                                    @foreach (var candidate in ownerCandidates)
                                    {
                                        <SelectOption TItemValue="int?" TItem="int?" Value="@((int?)candidate.Id)" Label="@candidate.Label" />
                                    }
                                </Select>
                            </div>
                            @if (CurrentRecord.OwnerUserId is null && !string.IsNullOrWhiteSpace(CurrentRecord.Owner) && !isNewRecordMode)
                            {
                                <div class="project-view-hint">原負責人：@CurrentRecord.Owner（找不到對應的帳號，請重新選擇）</div>
                            }
                            @if (!CanChangeOwner)
                            {
                                <div class="project-view-hint">只有主責團隊的成員或目前的負責人可以變更負責人。</div>
                            }
                        </FormItem>

                        @* 團隊＝「誰的資料」（0.4.102）：主責＋協作團隊的人看得到；能不能改由角色決定。
                           一般使用者的主責只能選自己所屬的團隊（主責沒變時保留原值），協作可選任何團隊。 *@
                        <FormItem Label="主責團隊" Required>
                            @* 0.4.114：改用 SelectOption 子元素（和協作、分類多選同寫法）。原本 DataSource 繫結在選項
                               開視窗前一刻才載入時，預設值不會顯示——畫面看起來空白、背後卻帶著值，專案就默默存到別的團隊。 *@
                            @* 下拉與日期欄包一層擋掉 Enter 冒泡（0.4.114）：在搜尋框按 Enter 選項目時，
                               外層 EditForm 的 @onkeydown 會把它當成送出。 *@
                            <div @onkeydown:stopPropagation="true">
                                <Select TItem="int?" TItemValue="int?"
                                        @bind-Value="CurrentRecord.PrimaryTeamId"
                                        @bind-Value:after="ReloadOwnerCandidatesAsync"
                                        Disabled="@(!CanEditTeams)"
                                        Placeholder="請選擇主責團隊"
                                        AllowClear EnableSearch Style="width: 100%;">
                                    @foreach (var team in PrimaryTeamOptions)
                                    {
                                        <SelectOption TItemValue="int?" TItem="int?" Value="@((int?)team.Id)" Label="@team.Name" />
                                    }
                                </Select>
                            </div>
                            <ValidationMessage For="() => CurrentRecord.PrimaryTeamId" />
                            @if (!PrimaryTeamOptions.Any())
                            {
                                @* 主責必填，但新系統一個團隊都沒有時下拉是空的，使用者無從得知要先去哪裡建（1.0.26）。
                                   連結開新頁籤：這張表單填到一半，直接換頁會整張不見。 *@
                                <div class="project-view-empty-teams">
                                    @if (CanCreateTeam)
                                    {
                                        <span>還沒有可以當主責的團隊。請先到</span>
                                        <a href="/teams" target="_blank" rel="noopener">資料定義 → 團隊清單</a>
                                        <span>新增團隊並加入成員，完成後按</span>
                                        <button type="button" class="project-view-empty-teams-reload" @onclick="ReloadTeamOptionsAsync">重新載入</button>
                                    }
                                    else
                                    {
                                        <span>你目前不屬於任何團隊，無法建立專案。請聯絡管理者把你加入團隊。</span>
                                    }
                                </div>
                            }
                        </FormItem>

                        <FormItem Label="協作團隊">
                            <div @onkeydown:stopPropagation="true">
                            <Select TItem="int" TItemValue="int" Mode="SelectMode.Multiple"
                                    Values="CurrentRecord.CollaboratorTeamIds" OnSelectedItemsChanged="OnCollaboratorTeamsChanged"
                                    Disabled="@(!CanEditTeams)"
                                    Placeholder="可加入其他共同參與的團隊"
                                    AllowClear EnableSearch Style="width: 100%;">
                                @foreach (var team in collaboratorTeamOptions.Where(x => x.Id != CurrentRecord.PrimaryTeamId))
                                {
                                    <SelectOption TItemValue="int" TItem="int" Value="@team.Id" Label="@team.Name" />
                                }
                            </Select>
                            </div>
                        </FormItem>

                        <div class="project-view-hint form-modal-full">
                            主責與協作團隊的成員（與管理者）看得到這個專案與底下的會議紀錄、待辦。
                            @if (!CanEditTeams)
                            {
                                <span>只有主責團隊的成員可以變更團隊設定。</span>
                            }
                        </div>

                        <FormItem Label="分類" Class="form-modal-full">
                            <div @onkeydown:stopPropagation="true">
                            <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                    Values="CurrentRecord.Categories" OnSelectedItemsChanged="OnRecordCategoriesChanged"
                                    Placeholder="描述專案性質，例如 .NET、成大（不影響誰看得到）"
                                    AllowClear EnableSearch Style="width: 100%;">
                                @foreach (var c in FormCategoryOptions)
                                {
                                    <SelectOption TItemValue="string" TItem="string" Value="@c">@c</SelectOption>
                                }
                            </Select>
                            </div>
                        </FormItem>

                        <FormItem Label="開始日期">
                            <div @onkeydown:stopPropagation="true">
                                <DatePicker TValue="DateTime?" @bind-Value="CurrentRecord.StartDate" AllowClear="true" Style="width: 100%;" />
                            </div>
                            <ValidationMessage For="() => CurrentRecord.StartDate" />
                        </FormItem>

                        <FormItem Label="結束日期">
                            <div @onkeydown:stopPropagation="true">
                                <DatePicker TValue="DateTime?" @bind-Value="CurrentRecord.EndDate" AllowClear="true" Style="width: 100%;" />
                            </div>
                            <ValidationMessage For="() => CurrentRecord.EndDate" />
                        </FormItem>

                        <FormItem Label="狀態" Required>
                            <Select TItem="string" TItemValue="string" @bind-Value="CurrentRecord.Status" Style="width: 100%;">
                                @foreach (var status in StatusOptions)
                                {
                                    <SelectOption Value="@status">@status</SelectOption>
                                }
                            </Select>
                            <ValidationMessage For="() => CurrentRecord.Status" />
                        </FormItem>

                        <FormItem Label="完成百分比" Required>
                            <div class="project-view-completion-slider">
                                <Slider TValue="double" @bind-Value="CompletionPercentageValue"
                                        Min="0" Max="100" Step="1" Marks="CompletionMarks" />
                            </div>
                            <ValidationMessage For="() => CurrentRecord.CompletionPercentage" />
                        </FormItem>

                        @* 兩份名單都跨整列：輸入框加上標籤列橫向長，塞進兩欄格線會很擠。

                           ⚠️ 這裡**刻意不用** AntDesign 的 SelectMode.Tags。0.4.71 實測過：
                           那個元件的搜尋輸入框在 Blazor Server ＋ 中文輸入法下會把組字中途的注音
                           留在欄位裡（症狀是「艾ㄑ－艾琪」這種殘留），元件內部雖然有 IsComposing
                           處理但擋不住逐鍵回傳伺服器的時間差。普通 <Input> 則量測確認正常
                           （用 CDP 的 Input.imeSetComposition 真實組字驗過）。

                           所以改成「普通輸入框 ＋ 新增鈕」，標籤外觀自己畫。
                           Enter 刻意不綁任何動作：中文輸入法用 Enter 確認候選字，綁了會誤觸。 *@
                        <FormItem Label="常用名詞" Class="form-modal-full">
                            @* ⚠️ 擋下 keydown 冒泡：外層 EditForm 的 @onkeydown 會把 Enter 當成
                               「確定並關閉」，而使用者按 Enter 多半只是要確認輸入法的候選字。 *@
                            <div class="project-view-tag-editor" @onkeydown:stopPropagation="true">
                                <div class="project-view-tag-input">
                                    <Input @bind-Value="glossaryTermDraft" Placeholder="輸入術語或產品名" />
                                    @* ⚠️ 不要依輸入框內容停用這顆鈕。Input 是 change（失焦）才回寫，
                                       按鈕會一直停用到失焦為止——而點一顆停用的按鈕不會觸發它的 click，
                                       使用者得點兩次才加得進去。空值由 handler 自己擋掉就好。 *@
                                    <Button OnClick="OnAddGlossaryTerm">新增</Button>
                                </div>
                                @if (CurrentRecord.GlossaryTerms.Count > 0)
                                {
                                    <div class="project-view-tag-list">
                                        @foreach (var term in CurrentRecord.GlossaryTerms)
                                        {
                                            var current = term;
                                            <span class="project-view-tag">
                                                <span>@current</span>
                                                <button type="button"
                                                        title="@($"移除 {current}")"
                                                        aria-label="@($"移除 {current}")"
                                                        @onclick="@(() => OnRemoveGlossaryTerm(current))">×</button>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="mt-2 text-muted">產生會議紀錄時會一併提供給 AI，用來把語音辨識聽錯的同音字改回正確寫法。</div>
                        </FormItem>

                        <FormItem Label="常用與會人員" Class="form-modal-full">
                            <div class="project-view-tag-editor" @onkeydown:stopPropagation="true">
                                <div class="project-view-tag-input">
                                    <Input @bind-Value="participantDraft" Placeholder="輸入姓名" />
                                    <Button OnClick="OnAddParticipant">新增</Button>
                                </div>
                                @if (CurrentRecord.Participants.Count > 0)
                                {
                                    <div class="project-view-tag-list">
                                        @foreach (var person in CurrentRecord.Participants)
                                        {
                                            var current = person;
                                            <span class="project-view-tag">
                                                <span>@current</span>
                                                <button type="button"
                                                        title="@($"移除 {current}")"
                                                        aria-label="@($"移除 {current}")"
                                                        @onclick="@(() => OnRemoveParticipant(current))">×</button>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="mt-2 text-muted">這是專案的長期名冊。每次產生會議紀錄時，再從這裡勾選該場實際到場的人。</div>
                        </FormItem>

                        <FormItem Label="專案附件" Class="form-modal-full">
                            <FileDropZone @ref="attachmentDropZone" OnChange="OnProjectFilesSelectedAsync" Multiple="true">
                                可一次選擇或拖入多個檔案，每個檔案上限 1GB。
                            </FileDropZone>
                        </FormItem>

                        @if (pendingUploadFiles.Count > 0)
                        {
                            <FormItem Label="待上傳檔案" Class="form-modal-full">
                                <ul class="list-group">
                                    @foreach (var file in pendingUploadFiles)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>@file.Name (@FormatFileSize(file.Size))</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemovePendingFile(file.Id)">移除</button>
                                        </li>
                                    }
                                </ul>
                            </FormItem>
                        }

                        @if (CurrentRecord.Files.Count > 0)
                        {
                            <FormItem Label="已上傳檔案" Class="form-modal-full">
                                <ul class="list-group">
                                    @foreach (var file in CurrentRecord.Files)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @* 不能用 <a href>：API 全是 JWT Bearer，瀏覽器導航帶 Cookie 一定 401，
                                               而 0.4.43 之前指向的那個端點更是從來沒存在過。走 JS interop 下載。 *@
                                            <button type="button" class="btn btn-link p-0 text-start"
                                                    disabled="@(downloadingFileId is not null)"
                                                    @onclick="() => OnDownloadProjectFileAsync(file)">
                                                @file.OriginalFileName
                                            </button>
                                            <span>
                                                @FormatFileSize(file.FileSize)
                                                @if (CanRemoveFiles)
                                                {
                                                    @* 1.0.52：刪除附件只限專案負責人。 *@
                                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="() => RemoveExistingFile(file.Id)">移除</button>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </FormItem>
                        }
                    </div>
                </AntDesign.Form>
            </EditForm>
        </div>
    </Modal>

    @* 檢視與編修 0.4.82 起共用同一個視窗，差別只在 CanEdit。
       編修模式是左改右看＋常駐搜尋取代列；唯讀模式只剩右邊的預覽。 *@
    <MarkdownEditorModal @bind-Visible="@draftModalVisible"
                         Title="@draftModalTitle"
                         Content="@draftContent"
                         CanEdit="@draftCanEdit"
                         CanExport="@draftCanExport"
                         IsExporting="@(exportingMeetingId is not null)"
                         IsSaving="@isSavingDraft"
                         CanSwitchToEdit="@draftCanSwitchToEdit"
                         OnRequestEdit="OnRequestDraftEdit"
                         OnCancelEdit="OnCancelDraftEdit"
                         CanGenerate="@draftCanGenerate"
                         OnGenerate="OnGenerateFromDraftModalAsync"
                         Transcript="@draftTranscript"
                         CanCopyTranscript="@draftCanCopyTranscript"
                         OnCopyTranscript="OnCopyTranscriptAsync"
                         OnDownloadTranscript="OnDownloadTranscriptAsync"
                         OnExport="OnExportCurrentDraftAsync"
                         OnSave="OnDraftSavedAsync" />

    <Modal Title="@("專案附件")"
           Class="form-modal-standard"
           @bind-Visible="@attachmentModalVisible"
           Keyboard="true"
           Footer="null"
           OnCancel="OnAttachmentModalCancel">
        <ul class="project-view-attachment-list">
            @foreach (var file in projectFiles)
            {
                <li class="project-view-attachment-row" @key="file.Id">
                    <div class="project-view-attachment-main">
                        <span class="project-view-attachment-name" title="@file.OriginalFileName">@file.OriginalFileName</span>
                        <span class="project-view-attachment-meta">
                            @FormatFileSize(file.FileSize) · 上傳於 @file.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                        </span>
                    </div>
                    <Button Type="ButtonType.Default"
                            Loading="@(downloadingFileId == file.Id)"
                            Disabled="@(downloadingFileId is not null && downloadingFileId != file.Id)"
                            OnClick="@(async () => await OnDownloadProjectFileAsync(file))">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="download" /><span>下載</span></span>
                    </Button>
                </li>
            }
        </ul>
    </Modal>

    @* CanExport 沿用清單頁「匯出 PDF」那一顆的權限，免得同一個畫面上出現
       「不能匯出會議紀錄、卻能匯出 AI 答案」。 *@
    <AiChatModal @bind-Visible="aiChatVisible"
                 Scope="@aiChatScope"
                 TargetId="@aiChatTargetId"
                 Title="@aiChatTitle"
                 TargetName="@aiChatTargetName"
                 CanExport="@AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Export)"
                 CanEdit="@AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Edit)"
                 CanDelete="@AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_專案項目, PermissionActions.Delete)" />

    <TodoExtractionModal @bind-Visible="todoExtractVisible"
                         MeetingId="@todoExtractMeetingId"
                         ProjectId="@(SelectedProject?.Id ?? 0)"
                         MeetingTitle="@todoExtractMeetingTitle" />
}
