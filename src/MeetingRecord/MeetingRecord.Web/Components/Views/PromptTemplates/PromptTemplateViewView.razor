@using MeetingRecord.Business.Helpers
@using MeetingRecord.Share.Helpers
@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        <div class="prompt-template-view-toolbar">
            <div class="prompt-template-view-toolbar-left">
                @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_提示詞清單, PermissionActions.Create))
                {
                    <Tooltip Title="新增">
                        <Button Type="ButtonType.Default"
                                OnClick="@(async () => await OnAddAsync())">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增</span></span>
                        </Button>
                    </Tooltip>

                    @* 提示詞是「AI 轉會議紀錄」的必要輸入，空清單等於核心功能不能用，
                       所以給新使用者一顆一次建好整組範本的鈕。已存在同名者會略過，可重複按。 *@
                    <Tooltip Title="一次建立全部內建範本，已存在的會略過">
                        <Button Type="ButtonType.Default"
                                Loading="@isSeedingPresets"
                                OnClick="@(async () => await OnAddAllPresetsAsync())">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="playlist_add" /><span>建立內建範本</span></span>
                        </Button>
                    </Tooltip>

                    @* 刻意做成「選單＋按鈕」兩步式：選單一改就直接寫入資料的話，
                       誤觸就多一筆而且沒有取消機會（AllowClear 也會把 null 送進 handler）。 *@
                    <Select TItem="string" TItemValue="string"
                            @bind-Value="selectedPresetName"
                            Placeholder="選擇內建範本"
                            AllowClear EnableSearch Style="min-width: 180px;">
                        @foreach (var preset in PromptTemplatePresets.All)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value="@preset.Name">@preset.Name</SelectOption>
                        }
                    </Select>
                    <Tooltip Title="只新增選取的那一個內建範本">
                        <Button Type="ButtonType.Default"
                                Disabled="@(string.IsNullOrWhiteSpace(selectedPresetName))"
                                OnClick="@(async () => await OnAddSelectedPresetAsync())">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增此範本</span></span>
                        </Button>
                    </Tooltip>
                }
                <Tooltip Title="重新整理">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnRefreshAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="refresh" /><span>重新整理</span></span>
                    </Button>
                </Tooltip>
            </div>
            <div class="prompt-template-view-toolbar-right">
                <Input class="prompt-template-view-search-input" @bind-Value="searchText" Placeholder="請輸入搜尋關鍵字" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <Tooltip Title="清空搜尋">
                        <Button Type="ButtonType.Default" OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="close" /><span>清空搜尋</span></span>
                        </Button>
                    </Tooltip>
                }
                <Tooltip Title="搜尋">
                    <Button Type="ButtonType.Default" OnClick="@(async () => await OnSearchAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="search" /><span>搜尋</span></span>
                    </Button>
                </Tooltip>
            </div>
        </div>
        <div class="prompt-template-view-table-wrap">
            <Table @ref="table"
                   TItem="PromptTemplateAdapterModel"
                   Class="prompt-template-view-table"
                   RemoteDataSource="true"
                   DataSource="@promptTemplateAdapterModels"
                   OnChange="OnTableChange"
                   @bind-PageIndex="_pageIndex"
                   @bind-PageSize="_pageSize"
                   @bind-Total="_total">
                <Column TData="string" DataIndex="@nameof(PromptTemplateAdapterModel.Name)" Title="名稱" Sortable />
                <Column TData="string" DataIndex="@nameof(PromptTemplateAdapterModel.ContentPreview)" Title="內容預覽" />
                <Column TData="string" DataIndex="@nameof(PromptTemplateAdapterModel.Description)" Title="描述" />
                <Column TData="bool" DataIndex="@nameof(PromptTemplateAdapterModel.IsEnabled)" Title="啟用狀態" Sortable>
                    @* 有 Edit 權限才做成可點的按鈕；沒權限就退回純文字，不要用 disabled 按鈕
                       ——disabled 的按鈕不可 focus，掛在上面的 aria-label 狀態說明就讀不到了。
                       可見文字講「狀態」、aria-label 與 title 講「動作」：把「啟用」直接當按鈕的
                       可及名稱會被讀成命令，語意與實際相反。 *@
                    @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_提示詞清單, PermissionActions.Edit))
                    {
                        <button type="button"
                                class="prompt-template-status @(context.IsEnabled ? "prompt-template-status-enabled" : "prompt-template-status-disabled")"
                                title="@($"點擊改為{(context.IsEnabled ? "停用" : "啟用")}")"
                                aria-label="@($"{context.Name} 目前為{(context.IsEnabled ? "啟用" : "停用")}，點擊改為{(context.IsEnabled ? "停用" : "啟用")}")"
                                @onclick="@(async () => await OnToggleEnabledAsync(context))">
                            @(context.IsEnabled ? "啟用" : "停用")
                        </button>
                    }
                    else
                    {
                        <span class="prompt-template-status @(context.IsEnabled ? "prompt-template-status-enabled" : "prompt-template-status-disabled")">
                            @(context.IsEnabled ? "啟用" : "停用")
                        </span>
                    }
                </Column>
                <Column TData="DateTime" DataIndex="@nameof(PromptTemplateAdapterModel.UpdatedAt)" Title="更新時間" Sortable DefaultSortOrder="SortDirection.Descending" />
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                    <Space>
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_提示詞清單, PermissionActions.Edit))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="修改" Icon="edit"
                                                  OnClick="@(async () => await OnEditAsync(context))" />
                            </SpaceItem>
                        }
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_提示詞清單, PermissionActions.Delete))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="刪除" Icon="delete" Danger
                                                  OnClick="@(async () => await OnDeleteAsync(context))" />
                            </SpaceItem>
                        }
                    </Space>
                </ActionColumn>
            </Table>
        </div>
    </div>

    <Modal Title="@modalTitle"
           Class="prompt-template-view-modal"
           @bind-Visible="@modalVisible"
           Keyboard="true"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <div>
            <EditForm Model="@CurrentRecord" Context="editContext" @onkeydown="OnModalKeyDownAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputWatcher EditContextActionChanged="OnEditContestChanged" />

                <AntDesign.Form TModel="PromptTemplateAdapterModel" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                    <FormItem Label="名稱" Required>
                        <Input @bind-Value="CurrentRecord.Name" Placeholder="請輸入提示詞名稱" />
                        <ValidationMessage For="() => CurrentRecord.Name" />
                    </FormItem>

                    <FormItem Label="提示詞內容" Required>
                        <TextArea @bind-Value="CurrentRecord.Content" Rows="14" Placeholder="請輸入產生會議紀錄時要送給模型的指令內容" />
                        <div class="prompt-template-view-variable-hint">
                            可使用的變數：@KnownVariableDescription（產生會議紀錄時會代入實際內容；其他變數會原樣輸出）
                        </div>
                        <ValidationMessage For="() => CurrentRecord.Content" />
                    </FormItem>

                    <FormItem Label="描述">
                        <TextArea @bind-Value="CurrentRecord.Description" Rows="3" Placeholder="請輸入提示詞用途說明" />
                        <ValidationMessage For="() => CurrentRecord.Description" />
                    </FormItem>

                    <FormItem Label="分類">
                        <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                Values="CurrentRecord.Categories" OnSelectedItemsChanged="OnRecordCategoriesChanged"
                                Placeholder="選擇分類" AllowClear EnableSearch Style="width: 100%;">
                            @foreach (var c in availableCategories)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@c">@c</SelectOption>
                            }
                        </Select>
                    </FormItem>

                    <FormItem Label="團隊">
                        <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                Values="CurrentRecord.Teams" OnSelectedItemsChanged="OnRecordTeamsChanged"
                                Placeholder="選擇團隊（不設定表示公開）" AllowClear EnableSearch Style="width: 100%;">
                            @foreach (var t in availableTeams)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@t">@t</SelectOption>
                            }
                        </Select>
                    </FormItem>

                    <FormItem Label="啟用狀態">
                        <Switch @bind-Value="CurrentRecord.IsEnabled" CheckedChildren="啟用" UnCheckedChildren="停用" />
                    </FormItem>
                </AntDesign.Form>
            </EditForm>
        </div>
    </Modal>
}

<FormModalHelper />
