@using MeetingRecord.Share.Helpers
@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        @* 一列排完：左邊是過濾與搜尋，右邊是新增與重新整理。
           欄寬刻意壓窄（專案 150／狀態 110／搜尋 160）讓整列在雙欄版面下仍塞得進去。 *@
        <div class="todo-view-toolbar">
            <div class="todo-view-toolbar-left">
                <Select TItem="ProjectAdapterModel"
                        TItemValue="int"
                        Value="@selectedProjectFilter"
                        ValueChanged="OnProjectFilterChanged"
                        DataSource="@availableProjects"
                        LabelName="@nameof(ProjectAdapterModel.Title)"
                        ValueName="@nameof(ProjectAdapterModel.Id)"
                        Placeholder="專案過濾"
                        AllowClear
                        EnableSearch
                        Style="width: 150px;" />
                <Select TItem="string" TItemValue="string"
                        Value="@selectedStatusFilter"
                        ValueChanged="OnStatusFilterChanged"
                        Placeholder="狀態過濾" AllowClear Style="width: 110px;">
                    @foreach (var status in StatusOptions)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@status">@status</SelectOption>
                    }
                </Select>
                @* 寬度用 Style 而不是 class：class 傳給 AntDesign 元件時不會帶 scoped CSS 的 scope 屬性，
                   .todo-view-search-input 那種寫法會被編成 [b-xxx] 而永遠選不到（原本的 220px 從來沒生效）。 *@
                <Input @bind-Value="searchText" Placeholder="搜尋關鍵字" Style="width: 160px;" />
                <Tooltip Title="搜尋">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnSearchAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="search" /><span>搜尋</span></span>
                    </Button>
                </Tooltip>
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <Tooltip Title="清空搜尋">
                        <Button Type="ButtonType.Default"
                                OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="close" /><span>清空搜尋</span></span>
                        </Button>
                    </Tooltip>
                }
            </div>
            <div class="todo-view-toolbar-right">
                @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Create))
                {
                    <Tooltip Title="新增">
                        <Button Type="ButtonType.Default"
                                Disabled="@(availableProjects.Count == 0)"
                                OnClick="@(async () => await OnAddAsync())">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增</span></span>
                        </Button>
                    </Tooltip>
                }
                <Tooltip Title="重新整理">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnRefreshAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="refresh" /><span>重新整理</span></span>
                    </Button>
                </Tooltip>
            </div>
        </div>

        @if (availableProjects.Count == 0)
        {
            <div class="todo-view-empty">
                目前沒有可存取的專案。待辦事項一定隸屬於某個專案，請先到「專案項目」建立一個專案。
            </div>
        }

        @* 左邊清單、右邊負責人面板。面板刻意只跟「專案過濾」連動，不跟狀態與關鍵字——
           它顯示的就是狀態分布，再被狀態過濾一次會得到「每個人都 100%」這種看似合理的錯誤數字。
           標題上會顯示目前範圍，免得使用者以為數字沒跟著過濾器動是 bug。 *@
        <div class="todo-view-body @(ownerPanelCollapsed ? "todo-view-body-collapsed" : string.Empty)">
            <div class="todo-view-table-wrap">
            <Table @ref="table"
                   TItem="TodoAdapterModel"
                   Class="todo-view-table"
                   ScrollX="1020px"
                   RemoteDataSource="true"
                   DataSource="@todoAdapterModels"
                   OnChange="OnTableChange"
                   @bind-PageIndex="_pageIndex"
                   @bind-PageSize="_pageSize"
                   @bind-Total="_total">
                <Column TData="bool" Title="完成" Width="70">
                    <Checkbox Checked="@context.IsCompleted"
                              Disabled="@(!AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Edit))"
                              CheckedChanged="@(EventCallback.Factory.Create<bool>(this, value => OnCompletedChangedAsync(context, value)))" />
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.Title)" Title="待辦事項" Sortable>
                    @* 只顯示大綱（單行省略），完整內容靠右邊那顆 icon 開唯讀視窗。
                       ellipsis 要生效，文字必須是有寬度約束的 flex 子項——純 inline span 上的
                       text-overflow 不會有任何作用，所以外面這層 flex 容器是必要的。 *@
                    <div class="todo-view-title-cell">
                        <span class="todo-view-title @(context.IsCompleted ? "todo-view-title-done" : string.Empty)"
                              title="@context.Title">@context.Title</span>
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            <CrudActionButton Title="檢視完整內容" Icon="info"
                                              OnClick="@(() => OpenDetail(context))" />
                        }
                    </div>
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.ProjectTitle)" Title="所屬專案" Sortable Width="140" />
                <Column TData="string" Title="來源會議紀錄" Width="135">
                    @if (string.IsNullOrWhiteSpace(context.MeetingTitle))
                    {
                        <span class="todo-view-muted">— 手動新增</span>
                    }
                    else
                    {
                        <span class="todo-view-source">
                            <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="description" />
                            @context.MeetingTitle
                        </span>
                    }
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.Owner)" Title="負責人" Sortable Width="95">
                    @(string.IsNullOrWhiteSpace(context.Owner) ? "未指定" : context.Owner)
                </Column>
                <Column TData="DateTime?" DataIndex="@nameof(TodoAdapterModel.DueDate)" Title="截止日" Sortable Width="165">
                    @* 日期與逾期天數各自 nowrap：整塊「逾期 N 天」最差只會掉到第二行，不會斷在「逾期 1」「天」中間。 *@
                    <span class="todo-view-due">
                        <span class="@(context.IsOverdue ? "todo-view-overdue" : string.Empty)">@context.DueDateOnlyText</span>
                        @if (context.IsOverdue)
                        {
                            <span class="todo-view-overdue todo-view-due-overdue">逾期 @context.OverdueDays 天</span>
                        }
                    </span>
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.Priority)" Title="優先度" Sortable Width="85">
                    <span class="todo-view-pill @PriorityCssClass(context.Priority)">@context.Priority</span>
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.Status)" Title="狀態" Sortable Width="95">
                    <span class="todo-view-pill @StatusCssClass(context.Status)">@context.Status</span>
                </Column>
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作" Width="90">
                    <Space>
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Edit))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="修改" Icon="edit"
                                                  OnClick="@(async () => await OnEditAsync(context))" />
                            </SpaceItem>
                        }
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Delete))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="刪除" Icon="delete" Danger
                                                  OnClick="@(async () => await OnDeleteAsync(context))" />
                            </SpaceItem>
                        }
                    </Space>
                </ActionColumn>
            </Table>
            </div>

            <aside class="todo-view-owner-panel @(ownerPanelCollapsed ? "todo-view-owner-panel-collapsed" : string.Empty)">
                <div class="todo-view-owner-head">
                    <h3 class="todo-view-owner-title">負責人工作量</h3>
                    @if (!ownerPanelCollapsed)
                    {
                        <span class="todo-view-owner-scope">@OwnerPanelScopeText</span>
                    }
                    <CrudActionButton Title="@(ownerPanelCollapsed ? "展開負責人工作量" : "收合負責人工作量")"
                                      Icon="@(ownerPanelCollapsed ? "expand_more" : "expand_less")"
                                      OnClick="ToggleOwnerPanel" />
                </div>

                @if (ownerPanelCollapsed)
                {
                    @* 收合時仍留一行摘要，否則使用者不知道展開會看到什麼。 *@
                    <div class="todo-view-owner-collapsed">
                        @OwnerPanelScopeText · @ownerSummaries.Count 位負責人
                    </div>
                }
                else if (ownerSummaries.Count == 0)
                {
                    <div class="todo-view-owner-empty">這個範圍內還沒有待辦事項。</div>
                }
                else
                {
                    <Select TItem="string" TItemValue="string"
                            Value="@selectedOwner"
                            ValueChanged="OnOwnerChangedAsync"
                            Placeholder="選擇負責人"
                            EnableSearch
                            Style="width: 100%;">
                        @foreach (var summary in ownerSummaries)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value="@summary.Owner">
                                @($"{summary.Owner}（{summary.Total}）")
                            </SelectOption>
                        }
                    </Select>

                    @if (SelectedOwnerSummary is { } current)
                    {
                        <div class="todo-view-owner-progress">
                            <div class="todo-view-owner-progress-head">
                                <span class="todo-view-owner-progress-label">完成度</span>
                                <span class="todo-view-owner-progress-value">@current.CompletionPercent%</span>
                            </div>
                            <Progress Type="ProgressType.Line" Size="ProgressSize.Small"
                                      Percent="current.CompletionPercent" ShowInfo="false" />
                            <div class="todo-view-owner-progress-caption">
                                已完成 @current.Completed / 共 @current.Total
                            </div>
                        </div>

                        <div class="todo-view-owner-stats">
                            <span class="todo-view-pill todo-view-status-pending">待辦 @current.Pending</span>
                            <span class="todo-view-pill todo-view-status-processing">進行中 @current.InProgress</span>
                            <span class="todo-view-pill todo-view-status-completed">已完成 @current.Completed</span>
                            @if (current.Overdue > 0)
                            {
                                <span class="todo-view-pill todo-view-overdue">逾期 @current.Overdue</span>
                            }
                        </div>
                    }

                    <ul class="todo-view-owner-list">
                        @foreach (var item in ownerTodos)
                        {
                            <li class="todo-view-owner-item" @key="item.Id">
                                <span class="todo-view-owner-item-title @(item.IsCompleted ? "todo-view-title-done" : string.Empty)"
                                      title="@item.Title">@item.Title</span>
                                <span class="todo-view-owner-item-meta">
                                    <span class="todo-view-pill @StatusCssClass(item.Status)">@item.Status</span>
                                    <span class="@(item.IsOverdue ? "todo-view-overdue" : "todo-view-muted")">@item.DueDateText</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </aside>
        </div>
    </div>

    <Modal Title="@modalTitle"
           Class="todo-view-modal form-modal-standard"
           @bind-Visible="@modalVisible"
           Keyboard="true"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <div>
            <EditForm Model="@CurrentRecord" Context="editContext" @onkeydown="OnModalKeyDownAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputWatcher EditContextActionChanged="OnEditContestChanged" />

                <AntDesign.Form TModel="TodoAdapterModel" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                    <div class="form-modal-grid">
                        <FormItem Label="待辦標題" Required>
                            <Input @bind-Value="CurrentRecord.Title" Placeholder="請輸入待辦標題" />
                            <ValidationMessage For="() => CurrentRecord.Title" />
                        </FormItem>

                        <FormItem Label="所屬專案" Required>
                            <Select TItem="ProjectAdapterModel"
                                    TItemValue="int"
                                    @bind-Value="CurrentRecord.ProjectId"
                                    DataSource="@availableProjects"
                                    LabelName="@nameof(ProjectAdapterModel.Title)"
                                    ValueName="@nameof(ProjectAdapterModel.Id)"
                                    Placeholder="請選擇專案"
                                    EnableSearch
                                    Style="width: 100%;" />
                            <ValidationMessage For="() => CurrentRecord.ProjectId" />
                        </FormItem>

                        <FormItem Label="負責人">
                            <Input @bind-Value="CurrentRecord.Owner" Placeholder="請輸入負責人" />
                            <ValidationMessage For="() => CurrentRecord.Owner" />
                        </FormItem>

                        <FormItem Label="截止日">
                            <DatePicker TValue="DateTime?" @bind-Value="CurrentRecord.DueDate" AllowClear="true" Style="width: 100%;" />
                            <ValidationMessage For="() => CurrentRecord.DueDate" />
                        </FormItem>

                        <FormItem Label="優先度" Required>
                            <Select TItem="string" TItemValue="string" @bind-Value="CurrentRecord.Priority" Style="width: 100%;">
                                @foreach (var priority in PriorityOptions)
                                {
                                    <SelectOption Value="@priority">@priority</SelectOption>
                                }
                            </Select>
                            <ValidationMessage For="() => CurrentRecord.Priority" />
                        </FormItem>

                        <FormItem Label="狀態" Required>
                            <Select TItem="string" TItemValue="string" @bind-Value="CurrentRecord.Status" Style="width: 100%;">
                                @foreach (var status in StatusOptions)
                                {
                                    <SelectOption Value="@status">@status</SelectOption>
                                }
                            </Select>
                            <ValidationMessage For="() => CurrentRecord.Status" />
                        </FormItem>

                        @if (!string.IsNullOrWhiteSpace(CurrentRecord.MeetingTitle))
                        {
                            <FormItem Label="來源會議紀錄" Class="form-modal-full">
                                <div class="todo-view-readonly">@CurrentRecord.MeetingTitle</div>
                            </FormItem>
                        }

                        <FormItem Label="描述" Class="form-modal-full">
                            <TextArea @bind-Value="CurrentRecord.Description" Rows="3" Placeholder="請輸入描述" />
                            <ValidationMessage For="() => CurrentRecord.Description" />
                        </FormItem>
                    </div>
                </AntDesign.Form>
            </EditForm>
        </div>
    </Modal>
}

@* 待辦內容的唯讀檢視。刻意放在元件根層而不是 <Column> 裡——放在欄位內會讓每一列都渲染一個視窗。
   描述來自 TextArea，換行有意義，比照檢視會議紀錄用 <pre> 保留。 *@
<Modal Title="@detailTitle"
       Class="todo-view-detail-modal"
       Width="800"
       @bind-Visible="@detailVisible"
       Keyboard="true"
       Footer="null"
       OnCancel="OnDetailCancel">
    <pre class="todo-view-detail-content">@detailContent</pre>
</Modal>

<FormModalHelper />
