@using MeetingRecord.Share.Helpers
@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        <div class="todo-view-toolbar">
            <div class="todo-view-toolbar-left">
                @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Create))
                {
                    <Tooltip Title="新增">
                        <Button Type="ButtonType.Default"
                                Disabled="@(availableProjects.Count == 0)"
                                OnClick="@(async () => await OnAddAsync())">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="add" /><span>新增</span></span>
                        </Button>
                    </Tooltip>
                }
                <Tooltip Title="重新整理">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnRefreshAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="refresh" /><span>重新整理</span></span>
                    </Button>
                </Tooltip>
            </div>
            <div class="todo-view-toolbar-right">
                <Select TItem="ProjectAdapterModel"
                        TItemValue="int"
                        Value="@selectedProjectFilter"
                        ValueChanged="OnProjectFilterChanged"
                        DataSource="@availableProjects"
                        LabelName="@nameof(ProjectAdapterModel.Title)"
                        ValueName="@nameof(ProjectAdapterModel.Id)"
                        Placeholder="專案過濾"
                        AllowClear
                        EnableSearch
                        Style="min-width: 180px;" />
                <Select TItem="string" TItemValue="string"
                        Value="@selectedStatusFilter"
                        ValueChanged="OnStatusFilterChanged"
                        Placeholder="狀態過濾" AllowClear Style="min-width: 130px;">
                    @foreach (var status in StatusOptions)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@status">@status</SelectOption>
                    }
                </Select>
                <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                        Values="selectedCategoryFilters" OnSelectedItemsChanged="OnCategoryFilterChanged"
                        Placeholder="分類過濾" AllowClear EnableSearch Style="min-width: 150px;">
                    @foreach (var c in availableCategories)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@c">@c</SelectOption>
                    }
                </Select>
                <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                        Values="selectedTeamFilters" OnSelectedItemsChanged="OnTeamFilterChanged"
                        Placeholder="團隊過濾" AllowClear EnableSearch Style="min-width: 150px;">
                    @foreach (var t in availableTeams)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@t">@t</SelectOption>
                    }
                </Select>
                <Input class="todo-view-search-input" @bind-Value="searchText" Placeholder="請輸入搜尋關鍵字" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <Tooltip Title="清空搜尋">
                        <Button Type="ButtonType.Default"
                                OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })">
                            <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="close" /><span>清空搜尋</span></span>
                        </Button>
                    </Tooltip>
                }
                <Tooltip Title="搜尋">
                    <Button Type="ButtonType.Default"
                            OnClick="@(async () => await OnSearchAsync())">
                        <span class="btn-icon-label"><MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="search" /><span>搜尋</span></span>
                    </Button>
                </Tooltip>
            </div>
        </div>

        @if (availableProjects.Count == 0)
        {
            <div class="todo-view-empty">
                目前沒有可存取的專案。待辦事項一定隸屬於某個專案，請先到「專案項目」建立一個專案。
            </div>
        }

        <div class="todo-view-table-wrap">
            <Table @ref="table"
                   TItem="TodoAdapterModel"
                   Class="todo-view-table"
                   RemoteDataSource="true"
                   DataSource="@todoAdapterModels"
                   OnChange="OnTableChange"
                   @bind-PageIndex="_pageIndex"
                   @bind-PageSize="_pageSize"
                   @bind-Total="_total">
                <Column TData="bool" Title="完成" Width="70">
                    <Checkbox Checked="@context.IsCompleted"
                              Disabled="@(!AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Edit))"
                              CheckedChanged="@(EventCallback.Factory.Create<bool>(this, value => OnCompletedChangedAsync(context, value)))" />
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.Title)" Title="待辦事項" Sortable>
                    <span class="todo-view-title @(context.IsCompleted ? "todo-view-title-done" : string.Empty)">@context.Title</span>
                    @if (!string.IsNullOrWhiteSpace(context.Description))
                    {
                        <span class="todo-view-subtitle">@context.Description</span>
                    }
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.ProjectTitle)" Title="所屬專案" Sortable />
                <Column TData="string" Title="來源會議紀錄">
                    @if (string.IsNullOrWhiteSpace(context.MeetingTitle))
                    {
                        <span class="todo-view-muted">— 手動新增</span>
                    }
                    else
                    {
                        <span class="todo-view-source">
                            <MaterialIcon Theme="MaterialIcon.Themes.Outlined" Kind="description" />
                            @context.MeetingTitle
                        </span>
                    }
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.Owner)" Title="負責人" Sortable>
                    @(string.IsNullOrWhiteSpace(context.Owner) ? "未指定" : context.Owner)
                </Column>
                <Column TData="DateTime?" DataIndex="@nameof(TodoAdapterModel.DueDate)" Title="截止日" Sortable>
                    <span class="@(context.IsOverdue ? "todo-view-overdue" : string.Empty)">@context.DueDateText</span>
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.Priority)" Title="優先度" Sortable>
                    <span class="todo-view-pill @PriorityCssClass(context.Priority)">@context.Priority</span>
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.Status)" Title="狀態" Sortable>
                    <span class="todo-view-pill @StatusCssClass(context.Status)">@context.Status</span>
                </Column>
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.CategoriesText)" Title="分類" />
                <Column TData="string" DataIndex="@nameof(TodoAdapterModel.TeamsText)" Title="團隊" />
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                    <Space>
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Edit))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="修改" Icon="edit"
                                                  OnClick="@(async () => await OnEditAsync(context))" />
                            </SpaceItem>
                        }
                        @if (AuthenticationStateHelper.CheckAccessAction(MagicObjectHelper.角色_待辦事項, PermissionActions.Delete))
                        {
                            <SpaceItem>
                                <CrudActionButton Title="刪除" Icon="delete" Danger
                                                  OnClick="@(async () => await OnDeleteAsync(context))" />
                            </SpaceItem>
                        }
                    </Space>
                </ActionColumn>
            </Table>
        </div>
    </div>

    <Modal Title="@modalTitle"
           Class="todo-view-modal"
           @bind-Visible="@modalVisible"
           Keyboard="true"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <div>
            <EditForm Model="@CurrentRecord" Context="editContext" @onkeydown="OnModalKeyDownAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputWatcher EditContextActionChanged="OnEditContestChanged" />

                <AntDesign.Form TModel="TodoAdapterModel" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                    <FormItem Label="待辦標題" Required>
                        <Input @bind-Value="CurrentRecord.Title" Placeholder="請輸入待辦標題" />
                        <ValidationMessage For="() => CurrentRecord.Title" />
                    </FormItem>

                    <FormItem Label="描述">
                        <TextArea @bind-Value="CurrentRecord.Description" Rows="3" Placeholder="請輸入描述" />
                        <ValidationMessage For="() => CurrentRecord.Description" />
                    </FormItem>

                    <FormItem Label="所屬專案" Required>
                        <Select TItem="ProjectAdapterModel"
                                TItemValue="int"
                                @bind-Value="CurrentRecord.ProjectId"
                                DataSource="@availableProjects"
                                LabelName="@nameof(ProjectAdapterModel.Title)"
                                ValueName="@nameof(ProjectAdapterModel.Id)"
                                Placeholder="請選擇專案"
                                EnableSearch
                                Style="width: 100%;" />
                        <ValidationMessage For="() => CurrentRecord.ProjectId" />
                    </FormItem>

                    @if (!string.IsNullOrWhiteSpace(CurrentRecord.MeetingTitle))
                    {
                        <FormItem Label="來源會議紀錄">
                            <div class="todo-view-readonly">@CurrentRecord.MeetingTitle</div>
                        </FormItem>
                    }

                    <FormItem Label="負責人">
                        <Input @bind-Value="CurrentRecord.Owner" Placeholder="請輸入負責人" />
                        <ValidationMessage For="() => CurrentRecord.Owner" />
                    </FormItem>

                    <FormItem Label="截止日">
                        <DatePicker TValue="DateTime?" @bind-Value="CurrentRecord.DueDate" AllowClear="true" Style="width: 100%;" />
                        <ValidationMessage For="() => CurrentRecord.DueDate" />
                    </FormItem>

                    <FormItem Label="優先度" Required>
                        <Select TItem="string" TItemValue="string" @bind-Value="CurrentRecord.Priority" Style="width: 100%;">
                            @foreach (var priority in PriorityOptions)
                            {
                                <SelectOption Value="@priority">@priority</SelectOption>
                            }
                        </Select>
                        <ValidationMessage For="() => CurrentRecord.Priority" />
                    </FormItem>

                    <FormItem Label="狀態" Required>
                        <Select TItem="string" TItemValue="string" @bind-Value="CurrentRecord.Status" Style="width: 100%;">
                            @foreach (var status in StatusOptions)
                            {
                                <SelectOption Value="@status">@status</SelectOption>
                            }
                        </Select>
                        <ValidationMessage For="() => CurrentRecord.Status" />
                    </FormItem>

                    <FormItem Label="分類">
                        <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                Values="CurrentRecord.Categories" OnSelectedItemsChanged="OnRecordCategoriesChanged"
                                Placeholder="選擇分類" AllowClear EnableSearch Style="width: 100%;">
                            @foreach (var c in availableCategories)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@c">@c</SelectOption>
                            }
                        </Select>
                    </FormItem>

                    <FormItem Label="團隊">
                        <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                Values="CurrentRecord.Teams" OnSelectedItemsChanged="OnRecordTeamsChanged"
                                Placeholder="選擇團隊（不設定表示公開）" AllowClear EnableSearch Style="width: 100%;">
                            @foreach (var t in availableTeams)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@t">@t</SelectOption>
                            }
                        </Select>
                    </FormItem>
                </AntDesign.Form>
            </EditForm>
        </div>
    </Modal>
}

<FormModalHelper />
